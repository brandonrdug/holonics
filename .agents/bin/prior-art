#!/usr/bin/env bash
# Recover related current and historical source; this is navigation, not a proof of composition.
set -euo pipefail
if [ "$#" -ne 1 ] || [ -z "$1" ]; then
  echo "usage: .agents/bin/prior-art 'subject|LeanName|rust_name|classical spelling'" >&2
  exit 2
fi
pat="$1"
cd "$(git rev-parse --show-toplevel)"
roots=(docs research/records research/experiments research/papers research/notebook research/design formal crates applications accelerators archive)
# rg status 1 means no matches; status 2 is a failed search, never an absence receipt.
files=$(rg -il --sort path -e "$pat" "${roots[@]}") || {
  status=$?
  [ "$status" -eq 1 ] || exit "$status"
}
titles=$(printf '%s\n' research/records/*.md | rg -i -e "$pat") || {
  status=$?
  [ "$status" -eq 1 ] || exit "$status"
}
count() { if [ -z "$1" ]; then echo 0; else printf '%s\n' "$1" | wc -l; fi; }
printf "[source-audit %s %s] prior-art '%s' over %s -> %s files, %s record titles\n" \
  "$(date -u +%F)" "$(git rev-parse --short HEAD)" "$pat" "${roots[*]}" "$(count "$files")" "$(count "$titles")"
if [ -n "$titles" ]; then printf '%s\n' "$titles" | sed -n '1,20s/^/  title: /p'; fi
for root in "${roots[@]}"; do
  matches=$(printf '%s\n' "$files" | rg "^${root}/") || true
  if [ -n "$matches" ]; then
    printf '  %s: %s matching files; first five addresses\n' "$root" "$(count "$matches")"
    printf '%s\n' "$matches" | sed -n '1,5s/^/    /p'
  fi
done
printf '%s\n' 'Read the relation and actual caller. Archive matches retain their recorded revision and scope; a search hit is not an implemented join.'
