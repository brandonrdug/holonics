+                             memory_order_relaxed);
+    return;
+  }
+  W denominator = workspace[width];
+  if (wzero_p(denominator) || wneg_p(denominator)) {
+    atomic_fetch_or_explicit((device atomic_uint *)slot, REFUSED_MALFORMED,
+                             memory_order_relaxed);
+    return;
+  }
