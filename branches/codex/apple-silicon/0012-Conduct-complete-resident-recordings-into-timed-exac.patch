+        uint32_t at = response_at + 2U * coordinate;
+        if (response_lo[at] != response_hi[at]
+            || response_lo[at + 1U] != response_hi[at + 1U]
+            || (coordinate >= response_raw_count
+                && (response_lo[at] != 0 || response_lo[at + 1U] != 0))) {
