+        for command in &self.commands {
+            match command {
+                Command::Kernel { .. } => c.kernel_nodes += 1,
+                Command::Fill { .. } => c.memset_nodes += 1,
+                Command::Copy { .. } => c.memcpy_nodes += 1,
