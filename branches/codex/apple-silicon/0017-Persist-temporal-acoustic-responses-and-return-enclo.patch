+fn rewrite_checksum(bytes: &mut [u8]) {
+    let footer = bytes.len() - END.len() - 32;
+    let digest = Sha256::digest(&bytes[..footer]);
+    bytes[footer..footer + 32].copy_from_slice(&digest);
+}
