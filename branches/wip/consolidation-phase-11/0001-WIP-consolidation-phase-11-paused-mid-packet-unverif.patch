+    }
+    fn current<'a, 'c>(v: &'a ResidentSection<'c>) -> ResidentConstitutiveCurrent<'a, 'c> {
+        ResidentConstitutiveCurrent::integers(v).unwrap()
+    }
+    fn assert_device_reading_is_the_relation_fibre(
+        law: &ResidentConstitutiveFibre<'_>,
+        s: &ResidentSurface<'_>,
+        sources: &[&[i64]],
