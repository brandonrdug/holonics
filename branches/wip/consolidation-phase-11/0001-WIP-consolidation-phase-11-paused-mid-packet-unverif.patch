+        );
+        assert!(!same_affine_fibre(
+            &fibre,
+            &AffineFibre::new(vec![r(6), r(1)], vec![vec![r(1), r(0)]])
+        ));
+    }
+
+    fn points<'c>(s: &'c ResidentSurface<'c>, v: &[i64]) -> ResidentSection<'c> {
+        s.mount_section_rest(
