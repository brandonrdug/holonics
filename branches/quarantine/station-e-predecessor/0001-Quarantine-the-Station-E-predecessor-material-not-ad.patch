+// ---------------------------------------------------------------------------------------------
+// THE NATIVE ATLAS — the suffix automaton's transport as compressed sparse rows, walked and read.
+// Rows are sorted by germ index; every value is an integer at grain 2^0. Nothing here is the
+// foreign arm's: the arrays are the native rest's own populations.
+// ---------------------------------------------------------------------------------------------
+
+// Binary search for `g` in the row of `state`; returns the slot or UINT32_MAX.
+__device__ __forceinline__ uint32_t athena_row_find(const uint32_t *indptr, const uint32_t *germ, uint32_t state, uint32_t g) {
+    uint32_t lo = indptr[state], hi = indptr[state + 1];
+    while (lo < hi) {
+        uint32_t mid = lo + (hi - lo) / 2;
+        uint32_t at = germ[mid];
+        if (at == g) return mid;
+        if (at < g) lo = mid + 1; else hi = mid;
+    }
+    return 0xFFFFFFFFu;
+}
+
+// The walk: one thread carries the prompt's germs from the root. Out T × 2: [class, mark] with
+// mark 1 forward, 0 arc (found at a shorter context), 2 unseen (the germ is not in the vocabulary;
+// the walk returns to the root).
+extern "C" __global__ void athena_walk(
+    const uint32_t *indptr, const uint32_t *germ, const uint32_t *target, const uint32_t *suffix,
+    const uint32_t *prompt, uint32_t prompt_len, uint32_t vocabulary,
+    int64_t *out_lo, int64_t *out_hi, uint32_t *refused, const uint32_t *census, const uint32_t *lineage, uint32_t lineage_count
+) {
+    uint32_t flat = blockIdx.x * blockDim.x + threadIdx.x;
+    if (flat != 0) return;
+    if (upstream_refused(census, lineage, lineage_count, refused)) return;
+    uint32_t state = 0;
+    for (uint32_t t = 0; t < prompt_len; t++) {
+        uint32_t g = prompt[t];
+        int64_t mark;
+        if (g >= vocabulary) {
+            state = 0; mark = 2;
+        } else {
+            uint32_t at = state;
+            mark = 1;
+            for (;;) {
+                uint32_t slot = athena_row_find(indptr, germ, at, g);
+                if (slot != 0xFFFFFFFFu) { state = target[slot]; break; }
+                uint32_t parent = suffix[at];
+                if (parent == at) { state = 0; mark = 0; break; }
+                at = parent; mark = 0;
+            }
+        }
+        out_lo[t * 2] = (int64_t)state; out_hi[t * 2] = (int64_t)state;
+        out_lo[t * 2 + 1] = mark;        out_hi[t * 2 + 1] = mark;
+    }
+}
+
+// The future section: for (position, germ) the standing of the class the germ reaches from the
+// landed class's suffix chain (`depth_face` 0), or how far up the chain it was found (`depth_face`
+// 1; −1 where unreached). In T × 2 (the walk), out T × V.
+extern "C" __global__ void athena_future(
+    const uint32_t *indptr, const uint32_t *germ, const uint32_t *target, const uint32_t *standing, const uint32_t *suffix,
+    const int64_t *walk_lo, uint32_t rows, uint32_t vocabulary, uint32_t depth_face,
+    int64_t *out_lo, int64_t *out_hi, uint32_t *refused, const uint32_t *census, const uint32_t *lineage, uint32_t lineage_count
+) {
+    uint32_t flat = blockIdx.x * blockDim.x + threadIdx.x;
+    if (flat >= rows * vocabulary) return;
+    if (upstream_refused(census, lineage, lineage_count, refused)) return;
+    uint32_t t = flat / vocabulary;
+    uint32_t v = flat % vocabulary;
+    uint32_t at = (uint32_t)walk_lo[t * 2];
+    int64_t depth = 0;
+    int64_t value = depth_face ? -1 : 0;
+    for (;;) {
+        uint32_t slot = athena_row_find(indptr, germ, at, v);
+        if (slot != 0xFFFFFFFFu) { value = depth_face ? depth : (int64_t)standing[target[slot]]; break; }
+        uint32_t parent = suffix[at];
+        if (parent == at) break;
+        at = parent; depth++;
+    }
+    out_lo[flat] = value; out_hi[flat] = value;
+}
+
