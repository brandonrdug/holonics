+            .map(|i| {
+                (0..2 * n)
+                    .map(|j| {
+                        let id = if i == j { Rat::one() } else { Rat::zero() };
+                        id - &half * &kr[i][j]
+                    })
+                    .collect()
+            })
+            .collect();
+        let rhs: Vec<Rat> = if adjoint {
+            p.to_vec()
+        } else {
+            (0..2 * n)
+                .map(|i| {
+                    let mut v = p[i].clone();
+                    for j in 0..2 * n {
+                        v += &half * &kr[i][j] * &p[j];
+                    }
+                    // W_c c: complex column m multiplies c_(2m) + i c_(2m+1).
+                    let a = i / 2;
+                    for m in 0..k / 2 {
+                        let (x, y) = w(a, n + m);
+                        let (cr, ci) = (&c[2 * m], &c[2 * m + 1]);
+                        v += if i % 2 == 0 {
+                            &x * cr - &y * ci
+                        } else {
+                            &x * ci + &y * cr
+                        };
+                    }
+                    v
+                })
+                .collect()
+        };
+        let matrix =
+            holonic_core::exact_linear::ExactRatMatrix::shaped(2 * n, 2 * n, system).unwrap();
