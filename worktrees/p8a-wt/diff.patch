+            assert!(yb.radius < int(1), "row {row}: radius {}", yb.radius);
+        }
+        // A certificate of another cut is refused.
+        let other = ResidentNormalMaterial::found_features(&surface, features, n, grain)
+            .unwrap()
+            .retained_view();
