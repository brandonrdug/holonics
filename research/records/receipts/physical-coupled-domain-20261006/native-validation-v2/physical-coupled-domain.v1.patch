+/// [agent-inferred] A finite tube, rather than a cyclic lock: for every compatible completion
+/// `x`, `|x_t - x_t^sparse| <= r_t` implies `|Phi_t(x_t) - Phi_t(x_t^sparse)| <= r_(t+1)`.
+/// The centre is the actual Word, never a proposed answer. The radius starts from the producing
+/// E and the missing cells' entire alphabet. Interior coordinates start at the contemporary
+/// entered carry, and each full tick includes junction, element, loaded return and contact.
+fn physical_domain_forward(
+    field: &Field,
+    material: &dyn FieldMaterial,
+    current: &Current,
+    section: &DamagedSection,
+    phases: &ReceivingPhases,
+    word: &mut Word<'_>,
+) -> Result<(Vec<Vec<Rat>>, Vec<Option<PhysicalDomainRead>>), HnnError> {
+    let mut radius = physical_opening_radius(field, material, current, section, word)?;
+    let mut domains = Vec::with_capacity(phases.aperture());
+    for crossing in 0..phases.junction_steps() {
+        let point = word.change()?;
+        let junctions = radius
+            .as_ref()
+            .map(|radius| physical_junction_radius(word.operands(), radius))
+            .transpose()?;
+        if phases.epochs().contains(&crossing) {
+            domains.push(match &junctions {
+                Some(junctions) => {
+                    let ring = phases.ring();
+                    let operands = word.operands();
+                    let incoming: Vec<_> = operands
+                        .incident(ring)
+                        .iter()
+                        .map(|&a| point.arrivals[a][operands.end_slot(a, ring)].as_slice())
+                        .collect();
+                    let anchor = crate::hnn::propagation::participation(
+                        operands.weights(ring),
+                        &point.storage[ring],
+                        &incoming,
+                    )?;
+                    Some(physical_domain_read(
+                        field,
+                        material,
+                        current,
+                        phases,
+                        &anchor,
+                        &junctions[ring].anchor,
+                    )?)
+                }
+                None => None,
+            });
+        }
+        if crossing + 1 == phases.junction_steps() {
+            word.last_junction()?;
+        } else {
+            radius = match (&radius, &junctions) {
+                (Some(radius), Some(junctions)) => Some(physical_tick_radius(
+                    word,
+                    &point,
+                    radius,
+                    junctions,
+                    word.opened_at() + crossing,
+                )?),
+                _ => None,
+            };
+            word.tick()?;
+        }
+    }
+    let anchors = phases
+        .epochs()
+        .map(|crossing| {
+            word.anchor(crossing, phases.ring())
+                .map(<[Rat]>::to_vec)
+                .ok_or(HnnError::WordEnded {
+                    ticks: word.ticks(),
+                })
+        })
+        .collect::<Result<Vec<_>, _>>()?;
+    Ok((anchors, domains))
+}
+
+/// The box is derived, never chosen: complete every missing station with any admitted class,
+/// at the same source clock and population chart; unite that image with the actual sparse open.
+/// Unit transport is the supported normalization law. A leaky source keeps its typed refusal.
+fn physical_opening_radius(
+    field: &Field,
+    material: &dyn FieldMaterial,
+    _current: &Current,
+    section: &DamagedSection,
+    word: &Word<'_>,
+) -> Result<Option<crate::hnn::word::EndChange>, HnnError> {
+    let operands = word.operands();
+    if operands.lattice().is_some()
+        || field
+            .sources()
+            .iter()
+            .any(|&ring| !material.transport(ring).is_one())
+        || operands.rings().iter().any(|ring| ring.chart().is_some())
+        || operands
+            .contacts()
+            .iter()
+            .any(|contact| contact.chart().is_some())
+        || operands.resonators().iter().flatten().any(|ring| {
+            (0..ring.phases()).any(|phase| {
+                ring.chart_words(phase).is_some() || !ring.certificate(phase).is_zero()
+            })
+        })
+    {
+        return Ok(None);
+    }
+    let point = word.change()?;
+    let mut radius = crate::hnn::word::EndChange::rest(field, operands);
+    let population = u64::try_from(section.length).map_err(|_| HnnError::Unadmitted {
+        reason: "the completion population must fit its declared source chart",
+    })?;
+    let weight = PopulationChart::of(field).value(population);
+    let placed = section.placed();
+    for &ring in field.sources() {
+        let geometry = field.ring(ring);
+        let map = material
+            .source_port(ring)
+            .ok_or(HnnError::MissingSourcePort { ring })?;
+        let mut lower = vec![Rat::zero(); geometry.width()];
+        let mut upper = lower.clone();
+        for (station, class) in placed.iter().enumerate() {
+            // P^tau P^(-(tau+1+j)) E_c: the already admitted station-clock square.
+            let columns = match class {
+                Some(class) => vec![*class],
+                None => (0..section.classes()).collect(),
+            };
+            let values = columns
+                .iter()
+                .map(|&class| {
+                    let column = (0..map.rows())
+                        .map(|row| map.get(row, class).cloned())
+                        .collect::<Result<Vec<_>, _>>()?;
+                    Ok(geometry.rotate(&column, &-(BigInt::from(station) + BigInt::one())))
+                })
+                .collect::<Result<Vec<_>, HnnError>>()?;
+            for coordinate in 0..geometry.width() {
+                lower[coordinate] += values.iter().map(|value| &value[coordinate]).min().unwrap();
+                upper[coordinate] += values.iter().map(|value| &value[coordinate]).max().unwrap();
+            }
+        }
+        for coordinate in 0..geometry.width() {
+            radius.storage[ring][coordinate] = (&weight * &lower[coordinate]
+                - &point.storage[ring][coordinate])
+                .abs()
+                .max((&weight * &upper[coordinate] - &point.storage[ring][coordinate]).abs());
+        }
+    }
+    Ok(Some(radius))
+}
+
+fn physical_add_radius(left: &[Rat], right: &[Rat]) -> Vec<Rat> {
+    left.iter()
+        .zip(right)
+        .map(|(left, right)| left + right)
+        .collect()
+}
+
+fn physical_scale_radius(scale: &Rat, vector: &[Rat]) -> Vec<Rat> {
+    vector.iter().map(|value| scale.abs() * value).collect()
+}
+
+fn physical_matrix_radius(
+    map: &crate::ratio::linear::ExactRatMatrix,
+    radius: &[Rat],
+) -> Result<Vec<Rat>, HnnError> {
+    (0..map.rows())
+        .map(|row| {
+            (0..map.columns())
+                .map(|column| Ok(map.get(row, column)?.abs() * &radius[column]))
+                .sum::<Result<Rat, HnnError>>()
+        })
+        .collect()
+}
+
+fn physical_junction_radius(
+    operands: &crate::hnn::propagation::Operands,
+    radius: &crate::hnn::word::EndChange,
+) -> Result<Vec<crate::hnn::propagation::Junction>, HnnError> {
+    (0..operands.rings().len())
+        .map(|ring| {
+            let incoming: Vec<_> = operands
+                .incident(ring)
+                .iter()
+                .map(|&a| radius.arrivals[a][operands.end_slot(a, ring)].as_slice())
+                .collect();
+            let anchor = crate::hnn::propagation::participation(
+                operands.weights(ring),
+                &radius.storage[ring],
+                &incoming,
+            )?;
+            let twice = physical_scale_radius(&crate::ratio::integer(2), &anchor);
+            Ok(crate::hnn::propagation::Junction {
+                storage_wave: physical_add_radius(&twice, &radius.storage[ring]),
+                contrast: physical_add_radius(&anchor, &radius.storage[ring]),
+                outgoing: incoming
+                    .iter()
+                    .map(|wave| physical_add_radius(&twice, wave))
+                    .collect(),
+                anchor,
+            })
+        })
+        .collect()
+}
+
+/// Image of a linear element relation under a coordinate box. The relation itself supplies the
+/// columns, so the enclosure shares its native operands instead of authoring another transit.
+fn physical_linear_radius(
+    inputs: &[&[Rat]],
+    output: usize,
+    apply: impl Fn(&[Vec<Rat>]) -> Result<Vec<Rat>, HnnError>,
+) -> Result<Vec<Rat>, HnnError> {
+    let mut basis: Vec<_> = inputs
+        .iter()
+        .map(|input| vec![Rat::zero(); input.len()])
+        .collect();
+    let mut image = vec![Rat::zero(); output];
+    for (part, radius) in inputs.iter().enumerate() {
+        for (coordinate, value) in radius
+            .iter()
+            .enumerate()
+            .filter(|(_, value)| !value.is_zero())
+        {
+            basis[part][coordinate] = Rat::one();
+            let column = apply(&basis)?;
+            basis[part][coordinate] = Rat::zero();
+            for (image, coefficient) in image.iter_mut().zip(column) {
+                *image += value * coefficient.abs();
+            }
+        }
+    }
+    Ok(image)
+}
+
+fn physical_tick_radius(
+    word: &Word<'_>,
+    point: &crate::hnn::word::EndChange,
+    radius: &crate::hnn::word::EndChange,
+    junctions: &[crate::hnn::propagation::Junction],
+    tick: usize,
+) -> Result<crate::hnn::word::EndChange, HnnError> {
+    let operands = word.operands();
+    let mut next = radius.clone();
+    let h = operands.step();
+    for (ring, junction) in junctions.iter().enumerate() {
+        let drive = physical_linear_radius(
+            &[&junction.storage_wave, &junction.contrast],
+            operands.rings()[ring].width(),
+            |basis| {
+                Ok(crate::hnn::propagation::element_step(
+                    &operands.rings()[ring],
+                    &basis[0],
+                    &basis[1],
+                )?
+                .next)
+            },
+        )?;
+        let Some(resonator) = &operands.resonators()[ring] else {
+            next.storage[ring] = drive;
+            continue;
+        };
+        let state = point.resonators[ring]
+            .as_ref()
+            .ok_or(HnnError::ContinuingState {
+                what: "the coupled enclosure needs the producing resonator state",
+            })?;
+        let state_radius = radius.resonators[ring]
+            .as_ref()
+            .ok_or(HnnError::ContinuingState {
+                what: "the coupled enclosure needs both resonator coordinate radii",
+            })?;
+        let phase = resonator.phase_at(tick);
+        let (capacity, _, _) = resonator.material().forms();
+        let nonlinear = resonator.material().saturation();
+        let factor = if nonlinear.is_some() {
+            crate::ratio::integer(1)
+        } else {
+            crate::ratio::integer(2)
+        };
+        let mut right = physical_add_radius(
+            &physical_scale_radius(
+                &factor,
+                &physical_matrix_radius(capacity, &state_radius[1])?,
+            ),
+            &physical_scale_radius(h, &drive),
+        );
+        let mut force = physical_matrix_radius(resonator.stiffness(phase), &state_radius[0])?;
+        if let Some(law) = nonlinear {
+            // On each complex node, |H_Q(u)| <= H_Q(U), U_i=|u_i^sparse|+r_i.
+            // This bounds the actual quartic effort difference over the entire box, including
+            // its cross-coordinate terms, and joins the state-dependent drive to that force.
+            let largest: Vec<_> = state[0]
+                .iter()
+                .zip(&state_radius[0])
+                .map(|(value, radius)| value.abs() + radius)
+                .collect();
+            force = physical_add_radius(
+                &force,
+                &physical_matrix_radius(&law.hessian(&largest)?, &state_radius[0])?,
+            );
+        }
+        right = physical_add_radius(&right, &physical_scale_radius(h, &force));
+        let rate = physical_matrix_radius(&resonator.operator(phase).inverse()?, &right)?;
+        let displacement = physical_add_radius(&state_radius[0], &physical_scale_radius(h, &rate));
+        let velocity = if nonlinear.is_some() {
+            rate.clone()
+        } else {
+            physical_add_radius(
+                &physical_scale_radius(&crate::ratio::integer(2), &rate),
+                &state_radius[1],
+            )
+        };
+        next.resonators[ring] = Some([displacement, velocity]);
+        next.storage[ring] = physical_add_radius(
+            &drive,
+            &physical_scale_radius(&(crate::ratio::integer(2) / resonator.admittance()), &rate),
+        );
+    }
+    for (a, contact) in operands.contacts().iter().enumerate() {
+        let (from, to) = contact.ends();
+        let outgoing = |ring: usize| {
+            &junctions[ring].outgoing[operands
+                .incident(ring)
+                .iter()
+                .position(|&index| index == a)
+                .unwrap()]
+        };
+        let inputs = [
+            outgoing(from).as_slice(),
+            outgoing(to).as_slice(),
+            radius.states[a][0].as_slice(),
+            radius.states[a][1].as_slice(),
+        ];
+        let n_from = inputs[0].len();
+        let n_to = inputs[1].len();
+        let n_state = contact.width();
+        let image = physical_linear_radius(&inputs, n_from + n_to + 2 * n_state, |basis| {
+            let passed = crate::hnn::propagation::transit(
+                contact, h, &basis[0], &basis[1], &basis[2], &basis[3],
+            )?;
+            Ok([
+                passed.arrive_from,
+                passed.arrive_to,
+                passed.displacement,
+                passed.rate,
+            ]
+            .concat())
+        })?;
+        next.arrivals[a] = [
+            image[..n_from].to_vec(),
+            image[n_from..n_from + n_to].to_vec(),
+        ];
+        next.states[a] = [
+            image[n_from + n_to..n_from + n_to + n_state].to_vec(),
+            image[n_from + n_to + n_state..].to_vec(),
+        ];
+    }
+    Ok(next)
+}
