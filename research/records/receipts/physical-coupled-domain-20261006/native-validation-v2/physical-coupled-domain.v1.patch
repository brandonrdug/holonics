+fn physical_domain_read(
+    field: &Field,
+    material: &dyn FieldMaterial,
+    current: &Current,
+    phases: &ReceivingPhases,
+    anchor: &[Rat],
+    radius: &[Rat],
+) -> Result<PhysicalDomainRead, HnnError> {
+    let point = phases.read(field, material, current, anchor)?;
+    let ring = phases.ring();
+    let transported: Vec<_> = field
+        .ring(ring)
+        .rotate(radius, &current.lift()[ring])
+        .into_iter()
+        .map(|value| value.abs())
+        .collect();
+    let radius = physical_matrix_radius(
+        material
+            .receiving_map(ring)
+            .ok_or(HnnError::MissingReceivingMap { ring })?,
+        &transported,
+    )?;
+    let logits: Vec<_> = point
+        .logits
+        .iter()
+        .zip(&radius)
+        .map(|(point, radius)| crate::ratio::algebraic::ExactInterval {
+            lower: point - radius,
+            upper: point + radius,
+        })
+        .collect();
+    let lower = (0..field.alphabet())
+        .map(|class| crate::receiver::face::GrainCell::of(&logits[2 * class].lower, phases.grain()))
+        .collect::<Result<Vec<_>, _>>()?;
+    let upper = (0..field.alphabet())
+        .map(|class| crate::receiver::face::GrainCell::of(&logits[2 * class].upper, phases.grain()))
+        .collect::<Result<Vec<_>, _>>()?;
+    let greatest_lower = lower
+        .iter()
+        .map(|cell| (&cell.carry, cell.phase))
+        .max()
+        .unwrap();
+    // Every native grain leader belongs to this fibre. One member therefore certifies the
+    // producing identity decoder's class reading throughout the compatible family.
+    let classes = upper
+        .iter()
+        .enumerate()
+        .filter(|(_, cell)| (&cell.carry, cell.phase) >= greatest_lower)
+        .map(|(class, _)| class)
+        .collect();
+    Ok(PhysicalDomainRead { logits, classes })
+}
