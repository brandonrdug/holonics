+// [realization; the lead, November 21, the contact kernels' source counters] **A staged term's skins**: the `n ≤ 8` modes' words of paced head
+// `p` at support entry `entry` read once, as `pair_skin_word` reads each (a word above `2^30` was never formed: it is refused and enters as zero),
+// into the warp's staged row, so that the lane holding a chunk's term issues its loads beside every other term's.
+__device__ __forceinline__ void stage_skin_words(const FieldWords &w, int32_t p, uint64_t entry, uint32_t n, uint32_t *out) {
+    const uint32_t *src = w.skin + ((uint64_t)p * w.E2 + entry) * n;
+    uint32_t v[8];
+    if (n == 8) {
+        const uint4 *s4 = reinterpret_cast<const uint4 *>(src);
+        const uint4 a = s4[0], b = s4[1];
+        v[0] = a.x; v[1] = a.y; v[2] = a.z; v[3] = a.w;
+        v[4] = b.x; v[5] = b.y; v[6] = b.z; v[7] = b.w;
+    } else {
+#pragma unroll
+        for (uint32_t l = 0; l < 8; l++) {
+            v[l] = l < n ? src[l] : 0;
+        }
+    }
+#pragma unroll
+    for (uint32_t l = 0; l < 8; l++) {
+        if (l < n) {
+            out[l] = (uint32_t)skin_word(w, v[l]);
+        }
+    }
+}
