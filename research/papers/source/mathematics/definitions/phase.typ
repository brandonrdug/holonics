#let phase = (
  key: "definition:phase",
  kind: [Definition],
  title: [Phase and discriminant],
  status: [Project definition],
  depends: (
    "definition:receiver",
    "definition:comparison-face",
  ),
  claim: [
    For a parameterized family of local transport laws, a *phase* is a maximal
    connected region on which the declared incidence, rank, transport class,
    and comparison law continue. Its *discriminant* is the boundary where one
    of those required structures fails to continue. Crossing that boundary is
    discrete when the carried invariant or admissible cell type changes.
  ],
  proof: none,
  boundary: [
    A phase depends on the selected family and invariants; it is not an
    observer-free label attached to isolated material.
  ],
)

