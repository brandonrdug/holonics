#let receiver = (
  key: "definition:receiver",
  kind: [Definition],
  title: [Receiver],
  status: [Project definition],
  depends: ("definition:situated-occurrence",),
  claim: [
    A *receiver* is a supplied map $q_rho:X -> Y_rho$ selecting the distinctions
    about a participating construction that can be presented at receiver
    $rho$. Its output is a face of $X$ at that cut; it is not the identity of
    $X$.
  ],
  proof: none,
  boundary: [
    A receiver map need not be injective, invertible, linear, metric, or scalar.
  ],
)

