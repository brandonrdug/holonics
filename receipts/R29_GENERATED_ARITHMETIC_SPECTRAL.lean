def primaryEigenvectorRelation (a b : ℤ) : Prop :=
  (a*1 + (-b)*0 = a) ∧ (a*0 + (-b)*(-1) = b) ∧
  (b*1 + a*0 = b) ∧ (b*0 + a*(-1) = -a) ∧
  (a*1 + (-b)*0 = a) ∧ (a*0 + (-b)*1 = -b) ∧
  (b*1 + a*0 = b) ∧ (b*0 + a*1 = a)

