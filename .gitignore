# Reproducible Cargo/Lake output and private runtime material.
/target/
/.local/
**/.lake/
__pycache__/
*.pyc
*.log

# Local agent/runtime configuration and isolated harness worktrees. The one tracked file is the
# repository's permission rules (CLAUDE.md, the trunk contract).
.claude/*
!.claude/settings.json
.codex/
.agents/
.opencode/

# Third-party working transcripts remain private, even inside frozen reference material.
archive/reference/external/3b1b-compression-*
.vscode/
