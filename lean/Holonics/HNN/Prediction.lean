import Mathlib.Tactic

/-!
# HNN.Prediction: the joint section, its release at width zero, and joint against marginals

[definition] THE_REBUILD U6, native generation (Brandon, September 29; #73, #148, #63). The Rust
owner is `holonics::hnn::prediction`. A requested consequence is generated by refining one field
and reading every station of its boundary from it, never by one independent prediction per
station (`docs/HNN_FORMULA.md`, "Generation as field refinement and boundary radiation", and
"Joint prediction is a boundary section of the future").

- **The refinement** is `K` words of one constituted step `F` from the prepared field
  `prepare seed` (the request's moment at rest): `F^[K]` (`refine_iterate`).
  One seed carries through every refinement (`Holon.ofEvolutionCompOccurrenceEquiv`); no trajectory
  is the occurrence.
- **The joint section** (`jointSection`) is the elementary Holon `Holon.ofEvolution` whose receiver
  reads every station from the one refined field: station `j`'s reading is `read j (F^[K] x)`
  (`jointSection_receive`). Its image over a seed family is the joint receiver `Γ_m`.
- **Joint is not marginals** (`joint_not_marginals`): the product of the stations' marginal images
  can hold a section no seed produces. Two seeds whose two stations read the same field give the
  joint image `{00, 11}`, and `01` lies in the marginal product but not in it. Reading stations
  independently from their marginals would release it. (`Computation/JointReceiverWitness` carries
  the three-packet and parity witnesses on fixed packets; this one is read through a refinement.)
- **Release at width zero** (`release_width_zero`): a section's reading that factors through a face
  constant on the compatible fibre has width zero over it, so the holding law at tolerance zero
  releases it; a reading that parts two members of the fibre has positive width and is held
  (`plural_section_held`). In Rust the face is the stations' grain cells, constant on the grain
  fibre of the logits, and the reading is every station's top class.
- **The consumer equation** (`consumer_eq`): `ρ(F^K(I_h)) = T(request)` is
  `Holon.ofEvolution_receive_eq_encoded` at `evolve := F^[K]`: the native refinement returns the
  reference's section whenever its encoding and reading squares commute.

- **The order repair** (the lessons record's failure 4; Brandon, September 29: "remainders?
  spectral placement"). A datum placed at its residue on a ring of period `D = ∏ dᵢ` (pairwise
  coprime factors) is placed at its joint residue class: two positions below `m·n` with the same
  residues mod `m` and mod `n` are the same position (`joint_residue_determines_position`), so the
  ring resolves position mod `D`. The joint class is placed on the product of the factors' spectra
  because a sum of per-factor functions cannot single out one joint class
  (`joint_class_not_additive`): separate factor placements summed would carry only their marginals.
  The section's locked datum at station `j` is read by station `j` at rotation zero
  (`placed_at_station`); a station locks only on a positive gap, so its top class is the unique
  greatest (`lock_reads_unique_top`); and a reading that depends on the targets only through the
  locked stations' placement never reads an unlocked (compared) station's target
  (`partition_reading_ignores_compared_targets`).

What this file does not state: the concrete word (`HNN/Word.fieldTick`) as the step `F`, the
continuing word's return as the exact adjoint of `F^[K]` (checked on every refinement in Rust, on
the executed charts, the concrete bridge owed in #62 with the diamond's), and any claim that the
learned readout reaches a terrain's truth (a measurement, in the notebook's receipts).
-/

namespace Holonics.HNN.Prediction

open Holonics
open Holonics.Foundation.ReceiverRelease

variable {Seed Field Station Class : Type*}

/-- [definition] **The refinement**: `K` applications of one constituted step. -/
def refine (step : Field → Field) (words : ℕ) : Field → Field :=
  step^[words]

/-- [proved-derived; formal-checked] **One more word is one more step** on the refined field: the
refinement clock advances by words, never by output stations. -/
theorem refine_iterate (step : Field → Field) (words : ℕ) (x : Field) :
    refine step (words + 1) x = step (refine step words x) := by
  simp only [refine]
  exact Function.iterate_succ_apply' step words x

/-- [definition] **The joint section** as an elementary Holon: the occurrence is the seed (the
request), the source the prepared field, the target the refined field, and the receiver reads every
station from that one refined field. -/
def jointSection (prepare : Seed → Field) (step : Field → Field) (words : ℕ)
    (read : Station → Field → Class) : Holon Field Field (Station → Class) :=
  Holon.ofEvolution prepare (refine step words) (fun x station => read station x)

/-- [proved-derived; formal-checked] **Every station reads the one refined field.** -/
theorem jointSection_receive (prepare : Seed → Field) (step : Field → Field) (words : ℕ)
    (read : Station → Field → Class) (seed : Seed) (station : Station) :
    (jointSection prepare step words read).receive seed station =
      read station (refine step words (prepare seed)) :=
  rfl

/-- [definition] **The joint image** of a family of sections: the sections the seeds produce. -/
def jointImage (sections : Seed → Station → Class) : Set (Station → Class) :=
  Set.range sections

/-- [definition] **The product of the marginal images**: every section whose each station is some
seed's reading at that station. -/
def marginalProduct (sections : Seed → Station → Class) : Set (Station → Class) :=
  {σ | ∀ station, ∃ seed, sections seed station = σ station}

/-- [proved-derived; formal-checked] The joint image lies inside the marginal product. -/
theorem jointImage_subset_marginalProduct (sections : Seed → Station → Class) :
    jointImage sections ⊆ marginalProduct sections := by
  rintro σ ⟨seed, rfl⟩ station
  exact ⟨seed, rfl⟩

/-- The two-seed witness: the seed is the field, one word is the identity step, and both stations
read the field itself. -/
def twoStationSection : Bool → Fin 2 → Bool :=
  (jointSection (fun seed : Bool => seed) id 1 (fun (_ : Fin 2) x => x)).receive

/-- The section `01`: station 0 reads `false`, station 1 reads `true`. -/
def mixedSection : Fin 2 → Bool := fun station => decide (station = 1)

/-- [proved-derived; formal-checked] **Joint is not marginals.** Through a refinement whose
stations read one field, the marginal product holds the section `01`, which no seed produces: the
joint image is `{00, 11}`. -/
theorem joint_not_marginals :
    mixedSection ∈ marginalProduct twoStationSection ∧
      mixedSection ∉ jointImage twoStationSection := by
  constructor
  · intro station
    refine ⟨mixedSection station, ?_⟩
    simp [twoStationSection, jointSection, refine, Holon.ofEvolution]
  · rintro ⟨seed, hseed⟩
    have h0 := congrFun hseed 0
    have h1 := congrFun hseed 1
    simp [twoStationSection, jointSection, refine, Holon.ofEvolution, mixedSection] at h0 h1
    rw [h0] at h1
    exact Bool.false_ne_true h1

/-- [proved-derived; formal-checked] **So the joint image differs from the marginal product.** -/
theorem jointImage_ne_marginalProduct :
    jointImage twoStationSection ≠ marginalProduct twoStationSection := by
  intro h
  exact joint_not_marginals.2 (h ▸ joint_not_marginals.1)

/-- [proved-derived; formal-checked] **Release at width zero.** A section's reading `code ∘ face`
that factors through a face constant on the compatible fibre `F` has width zero over it, and the
holding law at tolerance zero releases it. -/
theorem release_width_zero {X Face Probe Coarser : Type*} (F : Finset X) (hF : F.Nonempty)
    (face : X → Face) (code : Face → ℚ)
    (hconstant : ∀ x ∈ F, ∀ y ∈ F, face x = face y) :
    width F hF (code ∘ face) = 0 ∧
      (holdingLaw X Probe Coarser 0).decide F hF (code ∘ face) = ReleaseReturn.released := by
  have hwidth : width F hF (code ∘ face) = 0 :=
    (width_eq_zero_iff F hF (code ∘ face)).mpr fun x hx y hy => by
      simp only [Function.comp_apply, hconstant x hx y hy]
  refine ⟨hwidth, ?_⟩
  simp only [holdingLaw, hwidth, le_refl, if_true]

/-- [proved-derived; formal-checked] **A plural section is held.** When two members of the fibre
read different sections, the width is positive and the holding law at tolerance zero holds. -/
theorem plural_section_held {X Probe Coarser : Type*} (F : Finset X) (hF : F.Nonempty)
    (reading : X → ℚ) {x y : X} (hx : x ∈ F) (hy : y ∈ F) (hparted : reading x ≠ reading y) :
    0 < width F hF reading ∧
      (holdingLaw X Probe Coarser 0).decide F hF reading = ReleaseReturn.hold := by
  have hpositive : 0 < width F hF reading := by
    rcases lt_or_eq_of_le (width_nonneg F hF reading) with hlt | heq
    · exact hlt
    · exact absurd ((width_eq_zero_iff F hF reading).mp heq.symm x hx y hy) hparted
  refine ⟨hpositive, ?_⟩
  simp only [holdingLaw, not_le.mpr hpositive, if_false]

/-- [proved-derived; formal-checked] **The consumer equation** `ρ(F^K(I_h(ξ))) = T(request)`: the
native refinement returns the reference's section when its encoding and reading squares commute
(`Holon.ofEvolution_receive_eq_encoded` at `evolve := F^[K]`). -/
theorem consumer_eq {Encoded EncodedNext : Type*}
    (prepare : Seed → Field) (step : Field → Field) (words : ℕ)
    (read : Station → Field → Class)
    (encode : Field → Encoded) (encodeNext : Field → EncodedNext)
    (encodedRefine : Encoded → EncodedNext) (decode : EncodedNext → Station → Class)
    (hstep : ∀ x, encodeNext (refine step words x) = encodedRefine (encode x))
    (hread : ∀ x, decode (encodeNext x) = fun station => read station x) (seed : Seed) :
    (jointSection prepare step words read).receive seed =
      (Holon.ofEvolution (encode ∘ prepare) encodedRefine decode).receive seed :=
  Holon.ofEvolution_receive_eq_encoded prepare (refine step words)
    (fun x station => read station x) encode encodeNext encodedRefine decode hstep hread seed

/-! ## The order repair: the joint residue class, the section's placement and the lock -/

/-- [proved-derived; formal-checked] **The joint residue determines position** (the Chinese
remainder theorem on positions): below `m·n`, two positions with equal residues mod coprime `m` and
`n` are equal. Applied factor by factor, a ring of period `∏ dᵢ` over pairwise coprime `dᵢ` places
each datum at its position mod `∏ dᵢ`. -/
theorem joint_residue_determines_position {m n a b : ℕ} (hmn : Nat.Coprime m n)
    (ha : a < m * n) (hb : b < m * n) (hm : a % m = b % m) (hn : a % n = b % n) : a = b := by
  have h : a ≡ b [MOD m * n] := (Nat.modEq_and_modEq_iff_modEq_mul hmn).mp ⟨hm, hn⟩
  unfold Nat.ModEq at h
  rwa [Nat.mod_eq_of_lt ha, Nat.mod_eq_of_lt hb] at h

/-- [proved-derived; formal-checked] **One joint class is not a sum of per-factor functions**: on
two factors each with two distinct residues, no `f x + g y` equals the indicator of the class
`(x₀, y₀)`. A field that summed separate factor placements would read only their marginals, so the
joint class is placed on the product. -/
theorem joint_class_not_additive {X Y : Type*} [DecidableEq X] [DecidableEq Y] {x₀ x₁ : X}
    {y₀ y₁ : Y} (hx : x₀ ≠ x₁) (hy : y₀ ≠ y₁) :
    ¬ ∃ (f : X → ℚ) (g : Y → ℚ), ∀ x y, f x + g y = if x = x₀ ∧ y = y₀ then 1 else 0 := by
  rintro ⟨f, g, h⟩
  have a := h x₀ y₀
  have b := h x₁ y₁
  have c := h x₀ y₁
  have d := h x₁ y₀
  rw [if_pos ⟨rfl, rfl⟩] at a
  rw [if_neg (fun e => hx e.1.symm)] at b
  rw [if_neg (fun e => hy e.2.symm)] at c
  rw [if_neg (fun e => hx e.1.symm)] at d
  linarith

/-- [proved-derived; formal-checked] **A placed datum sits at its station's rotation zero**: the
datum locked at station `j` is placed at the tick `τ + 1 + j`, so in the request's frame it sits at
the rotation `τ − (τ + 1 + j)`, and station `j` reads the rotation `1 + j` of that frame. -/
theorem placed_at_station {D : ℕ} (τ j : ZMod D) : (1 + j) + (τ - (τ + 1 + j)) = 0 := by
  ring

/-- [proved-derived; formal-checked] **A lock reads a unique top.** A station locks only when its
top class's score leads every other class's by a positive gap, so the top is the unique greatest:
the lock is a width-zero reading of that station. -/
theorem lock_reads_unique_top {C : Type*} (score : C → ℤ) (top : C) (gap : ℤ) (hgap : 0 < gap)
    (hlead : ∀ c, c ≠ top → score c + gap ≤ score top) :
    ∀ c, score top ≤ score c → c = top := by
  intro c hc
  by_contra hne
  have := hlead c hne
  linarith

/-- [proved-derived; formal-checked] **A compared station never reads its own target.** A reading
that sees the targets only through the placement of the locked stations (`locked j`, the datum
`some (t j)`; an unlocked station places nothing) is the same for two target sections that agree at
the locked stations, whatever they hold at the compared ones. -/
theorem partition_reading_ignores_compared_targets {Station Class Reading : Type*}
    (locked : Station → Prop) [DecidablePred locked] (read : (Station → Option Class) → Reading)
    (t t' : Station → Class) (hagree : ∀ j, locked j → t j = t' j) :
    read (fun j => if locked j then some (t j) else none) =
      read (fun j => if locked j then some (t' j) else none) := by
  congr 1
  funext j
  by_cases hj : locked j
  · simp [hj, hagree j hj]
  · simp [hj]

