import Mathlib.Data.ZMod.Basic
import Mathlib.Algebra.GCDMonoid.Finset
import Mathlib.Algebra.Group.AddChar
import Mathlib.GroupTheory.SpecificGroups.Dihedral
import Mathlib.Tactic

/-!
# The base-action lemma: a digit move is a translation, a mirror, a flattening or a turn

The record `research/records/2026-10-26_THE_GENERATOR_AND_THE_MODULATOR_ARE_ONE_MOVE_AND_THE_PLACE_DECIDES_WHICH_SO_A_RING_COPRIME_TO_TEN_NEEDS_A_ROTOR.md`
(§§7, 11, 12) reads one digit of radix `b` as the move `x ↦ b x + d` on a ring `ℤ/m`, and owes three
statements to #410: (f) the base-action lemma and its grain staircase, (g) the residue address,
and (h) the dihedral group generated by two reflections. This file states and proves them.

[proved-standard; formal-checked] What is proved.

1. **The place decides the kind** (`digitMove_translation`, `digitMove_mirror`,
   `digitMove_mirror_involutive`, `digitMove_flattening`). On any commutative ring the move
   `x ↦ b x + d` is the translation by `d` when `b = 1`, the mirror `x ↦ d − x` (an involution) when
   `b = −1`, and the constant `d` when `b = 0`.
2. **Otherwise it permutes the colours and turns each** (`digitMove_on_characters`,
   `unit_permutes_characters`). For every additive character `ψ` and every frequency `a`,
   `ψ(a·(b x + d)) = ψ(a d)·ψ((b a)·x)`: the move sends the character of frequency `a` to the
   character of frequency `b a` and turns it by the phase `ψ(a d)`. When `b` is a unit,
   `a ↦ b a` is a permutation of the frequencies.
3. **A word of `k` digits is one move with base `bᵏ`** (`word_action`). Folding the digits
   `d₁ … d_k` into `x` gives `bᵏ x + D`, where `D` is the word's value read from `0`.
4. **The grain staircase** (`one_plane_iff`). Hence ring `m` is one plane at grain `k`, the
   `k`-digit move being a translation, a mirror or a flattening, exactly when `m` divides
   `bᵏ − 1`, `bᵏ + 1` or `bᵏ`.
5. **A ring mixing the base's primes with others is never one plane**
   (`mixed_ring_never_one_plane`). If a prime `p` divides both `m` and `b`, and a prime `q`
   divides `m` but not `b`, then for `k ≥ 1` the ring `m` divides none of `bᵏ − 1`, `bᵏ + 1`, `bᵏ`.
6. **The residue address** (`residue_address`, `address_nine_ten_eleven`, `address990`). Faces on
   rings `m ∈ S` agree exactly when the readings agree modulo `lcm S`, so the faces of rings 9, 10
   and 11 address `n mod 990`; by the Chinese remainder theorem every triple of faces is reached
   once (`address990`, a ring isomorphism).
7. **Two reflections generate the dihedral group** (`two_reflections`,
   `two_reflections_generate`). In `DihedralGroup n` the reflections `sr 0` and `sr 1` are
   involutions whose product is the rotation `r 1`, of order `n` (for `n = 0`, infinite order: the
   infinite dihedral group), and together they generate the whole group.

Consumers: the atlas rows `radix.digit-move-place-kind`, `radix.base-neighbour-rings`,
`radix.grain-staircase` and `radix.uncoupled-bank-dihedral`; the record's rotor reads the
character permutation of item 2.
-/

namespace Holonics.Mathematics.BaseAction

section Move

variable {R : Type*} [CommRing R]

/-- One digit `d` read in radix `b`: the affine move `x ↦ b x + d`. -/
def digitMove (b d x : R) : R := b * x + d

/-- [proved-standard; formal-checked] When `b = 1` the move is the translation by `d`. -/
theorem digitMove_translation (d x : R) : digitMove 1 d x = x + d := by
  simp [digitMove]

/-- [proved-standard; formal-checked] When `b = −1` the move is the mirror `x ↦ d − x`. -/
theorem digitMove_mirror (d x : R) : digitMove (-1) d x = d - x := by
  simp only [digitMove]
  ring

/-- [proved-standard; formal-checked] The mirror is an involution. -/
theorem digitMove_mirror_involutive (d : R) : Function.Involutive (digitMove (-1) d) := by
  intro x
  simp only [digitMove]
  ring

/-- [proved-standard; formal-checked] When `b = 0` the move flattens every place to `d`. -/
theorem digitMove_flattening (d x : R) : digitMove 0 d x = d := by
  simp [digitMove]

/-- [proved-standard; formal-checked] **The base-action lemma on characters.** The move sends the
character of frequency `a` to the character of frequency `b a`, turned by the phase `ψ(a d)`. -/
theorem digitMove_on_characters {M : Type*} [CommMonoid M] (ψ : AddChar R M) (a b d x : R) :
    ψ (a * digitMove b d x) = ψ (a * d) * ψ ((b * a) * x) := by
  have h : a * digitMove b d x = (b * a) * x + a * d := by
    simp only [digitMove]
    ring
  rw [h, AddChar.map_add_eq_mul, mul_comm]

/-- [proved-standard; formal-checked] A unit base permutes the frequencies. -/
theorem unit_permutes_characters {b : R} (hb : IsUnit b) :
    Function.Bijective (fun a : R => b * a) := by
  obtain ⟨u, rfl⟩ := hb
  exact (Units.mulLeft u).bijective

/-- [proved-standard; formal-checked] **A word of digits is one move with base `bᵏ`.** -/
theorem word_action (b : R) (ds : List R) (x : R) :
    ds.foldl (fun y d => digitMove b d y) x =
      b ^ ds.length * x + ds.foldl (fun y d => digitMove b d y) 0 := by
  induction ds generalizing x with
  | nil => simp
  | cons d ds ih =>
    simp only [List.foldl_cons, List.length_cons]
    rw [ih (digitMove b d x), ih (digitMove b d 0)]
    simp only [digitMove]
    ring

end Move

/-- [proved-standard; formal-checked] **The grain staircase.** The `k`-digit move on `ℤ/m` is a
translation, a mirror or a flattening exactly when `m` divides `bᵏ − 1`, `bᵏ + 1` or `bᵏ`. -/
theorem one_plane_iff (m : ℕ) (b : ℤ) (k : ℕ) :
    ((b : ZMod m) ^ k = 1 ∨ (b : ZMod m) ^ k = -1 ∨ (b : ZMod m) ^ k = 0) ↔
      ((m : ℤ) ∣ b ^ k - 1 ∨ (m : ℤ) ∣ b ^ k + 1 ∨ (m : ℤ) ∣ b ^ k) := by
  have key : ∀ c : ℤ, (c : ZMod m) = 0 ↔ (m : ℤ) ∣ c := fun c =>
    ZMod.intCast_zmod_eq_zero_iff_dvd c m
  rw [← key, ← key, ← key]
  push_cast
  simp only [sub_eq_zero, add_eq_zero_iff_eq_neg]

/-- [proved-standard; formal-checked] **A ring mixing the base's primes with others is never one
plane.** -/
theorem mixed_ring_never_one_plane {m b p q k : ℕ} (hp : p.Prime) (hq : q.Prime)
    (hpm : p ∣ m) (hpb : p ∣ b) (hqm : q ∣ m) (hqb : ¬ q ∣ b) (hk : 0 < k) :
    ¬ (m : ℤ) ∣ (b : ℤ) ^ k - 1 ∧ ¬ (m : ℤ) ∣ (b : ℤ) ^ k + 1 ∧ ¬ (m : ℤ) ∣ (b : ℤ) ^ k := by
  have hpbk : (p : ℤ) ∣ (b : ℤ) ^ k := dvd_pow (Int.natCast_dvd_natCast.mpr hpb) hk.ne'
  have hpm' : (p : ℤ) ∣ (m : ℤ) := Int.natCast_dvd_natCast.mpr hpm
  have hp1 : ¬ (p : ℤ) ∣ 1 := by exact_mod_cast hp.not_dvd_one
  refine ⟨fun h => hp1 ?_, fun h => hp1 ?_, fun h => hqb ?_⟩
  · have := dvd_sub hpbk (hpm'.trans h)
    simpa using this
  · have := dvd_sub (hpm'.trans h) hpbk
    simpa using this
  · have hq' : (q : ℤ) ∣ (b : ℤ) ^ k := (Int.natCast_dvd_natCast.mpr hqm).trans h
    have hqk : q ∣ b ^ k := by exact_mod_cast hq'
    exact hq.dvd_of_dvd_pow hqk

/-- [proved-standard; formal-checked] **The residue address.** Readings agree on every ring of
`S` exactly when they agree modulo `lcm S`. -/
theorem residue_address (S : Finset ℤ) (a a' : ℤ) :
    (∀ m ∈ S, a ≡ a' [ZMOD m]) ↔ a ≡ a' [ZMOD S.lcm id] := by
  simp only [Int.modEq_iff_dvd, Finset.lcm_dvd_iff, id_eq]

/-- [proved-standard; formal-checked] Rings 9, 10 and 11 address `n mod 990`. -/
theorem address_nine_ten_eleven : ({9, 10, 11} : Finset ℤ).lcm id = 990 := by
  decide +kernel

/-- [proved-standard; formal-checked] Every triple of faces on rings 9, 10 and 11 is reached by
exactly one residue mod 990 (the Chinese remainder theorem, as a ring isomorphism). -/
def address990 : ZMod 990 ≃+* ZMod 9 × ZMod 10 × ZMod 11 :=
  (ZMod.chineseRemainder (show Nat.Coprime 9 110 by norm_num)).trans
    (RingEquiv.prodCongr (RingEquiv.refl _)
      (ZMod.chineseRemainder (show Nat.Coprime 10 11 by norm_num)))

section Dihedral

open DihedralGroup

/-- [proved-standard; formal-checked] **Two reflections.** `sr 0` and `sr 1` are involutions, and
their product is the rotation `r 1`, of order `n` (infinite order when `n = 0`). -/
theorem two_reflections (n : ℕ) :
    sr (0 : ZMod n) * sr 0 = 1 ∧ sr (1 : ZMod n) * sr 1 = 1 ∧
      sr (0 : ZMod n) * sr 1 = r 1 ∧ orderOf (sr (0 : ZMod n) * sr 1) = n := by
  refine ⟨sr_mul_self 0, sr_mul_self 1, by rw [sr_mul_sr, sub_zero], ?_⟩
  rw [sr_mul_sr, sub_zero, orderOf_r_one]

/-- [proved-standard; formal-checked] **Two reflections generate the dihedral group**, finite or
infinite. -/
theorem two_reflections_generate (n : ℕ) :
    Subgroup.closure ({sr 0, sr 1} : Set (DihedralGroup n)) = ⊤ := by
  rw [eq_top_iff]
  rintro g -
  have h0 : (sr 0 : DihedralGroup n) ∈ Subgroup.closure ({sr 0, sr 1} : Set (DihedralGroup n)) :=
    Subgroup.subset_closure (by simp)
  have h1 : (sr 1 : DihedralGroup n) ∈ Subgroup.closure ({sr 0, sr 1} : Set (DihedralGroup n)) :=
    Subgroup.subset_closure (by simp)
  have hr1 : (r 1 : DihedralGroup n) ∈ Subgroup.closure ({sr 0, sr 1} : Set (DihedralGroup n)) := by
    have := Subgroup.mul_mem _ h0 h1
    rwa [sr_mul_sr, sub_zero] at this
  have hr : ∀ k : ZMod n,
      (r k : DihedralGroup n) ∈ Subgroup.closure ({sr 0, sr 1} : Set (DihedralGroup n)) := by
    intro k
    obtain ⟨z, rfl⟩ := ZMod.intCast_surjective k
    rw [← r_one_zpow]
    exact Subgroup.zpow_mem _ hr1 z
  rcases g with k | k
  · exact hr k
  · have := Subgroup.mul_mem _ h0 (hr k)
    rwa [sr_mul_r, zero_add] at this

end Dihedral

end Holonics.Mathematics.BaseAction
