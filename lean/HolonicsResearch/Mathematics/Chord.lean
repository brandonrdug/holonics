local instance : Fact (Nat.Prime 5) := ⟨by norm_num⟩

private theorem padicValRat_two_two : padicValRat 2 (2 : ℚ) = 1 := by
  have h := padicValRat.self (p := 2) (by norm_num)
  exact_mod_cast h

private theorem padicValRat_three_three : padicValRat 3 (3 : ℚ) = 1 := by
  have h := padicValRat.self (p := 3) (by norm_num)
  exact_mod_cast h

private theorem padicValRat_five_five : padicValRat 5 (5 : ℚ) = 1 := by
  have h := padicValRat.self (p := 5) (by norm_num)
  exact_mod_cast h

/-- [proved-standard] **The place at two reads `v₂`.** -/
theorem padicValRat_two_interval (v : ℤ × ℤ × ℤ) : padicValRat 2 (interval v) = v.1 := by
  unfold interval
  rw [padicValRat.mul (by positivity) (by positivity), padicValRat.mul (by positivity) (by positivity),
    padicValRat.zpow, padicValRat.zpow, padicValRat.zpow, padicValRat_two_three, padicValRat_two_five,
    padicValRat_two_two]
  ring

/-- [proved-standard] **The place at three reads `v₃`.** -/
theorem padicValRat_three_interval (v : ℤ × ℤ × ℤ) : padicValRat 3 (interval v) = v.2.1 := by
  unfold interval
  rw [padicValRat.mul (by positivity) (by positivity), padicValRat.mul (by positivity) (by positivity),
    padicValRat.zpow, padicValRat.zpow, padicValRat.zpow, padicValRat_three_two, padicValRat_three_five,
    padicValRat_three_three]
  ring

/-- [proved-standard] **The place at five reads `v₅`.** -/
theorem padicValRat_five_interval (v : ℤ × ℤ × ℤ) : padicValRat 5 (interval v) = v.2.2 := by
  unfold interval
  rw [padicValRat.mul (by positivity) (by positivity), padicValRat.mul (by positivity) (by positivity),
    padicValRat.zpow, padicValRat.zpow, padicValRat.zpow, padicValRat_five_two, padicValRat_five_three,
    padicValRat_five_five]
  ring

/-- [proved-standard] **One rational, one point of the lattice**: the finite places read the valuations back. -/
theorem interval_injective : Function.Injective interval := by
  intro v w h
  have h2 : v.1 = w.1 := by rw [← padicValRat_two_interval, ← padicValRat_two_interval, h]
  have h3 : v.2.1 = w.2.1 := by rw [← padicValRat_three_interval, ← padicValRat_three_interval, h]
  have h5 : v.2.2 = w.2.2 := by rw [← padicValRat_five_interval, ← padicValRat_five_interval, h]
  exact Prod.ext h2 (Prod.ext h3 h5)

/-! ## 2. The temperament and its kernel -/

/-- Twelve equal steps on the 5-limit: the covector `⟨12, 19, 28|`. -/
def temper : ℤ × ℤ × ℤ →+ ℤ where
  toFun v := 12 * v.1 + 19 * v.2.1 + 28 * v.2.2
  map_zero' := by simp
  map_add' v w := by
    simp only [Prod.fst_add, Prod.snd_add]
    ring

/-- [proved-standard] The temperament's reading of a point. -/
theorem temper_apply (v : ℤ × ℤ × ℤ) : temper v = 12 * v.1 + 19 * v.2.1 + 28 * v.2.2 := rfl

/-- [proved-standard] The octave is twelve steps, the fifth seven and the major third four. -/
theorem temper_steps : temper (1, 0, 0) = 12 ∧ temper (-1, 1, 0) = 7 ∧ temper (-2, 0, 1) = 4 := by
  simp [temper_apply]

/-- [proved-derived] The syntonic comma and the diesis are in the kernel: `−48 + 76 − 28 = 0` and `84 − 84 = 0`. -/
theorem temper_commas : temper (-4, 4, -1) = 0 ∧ temper (7, 0, -3) = 0 := by
  simp [temper_apply]

/-- [proved-derived] **The temperament's kernel is generated by the syntonic comma and the diesis.** -/
theorem temper_ker_iff (v : ℤ × ℤ × ℤ) :
    temper v = 0 ↔ ∃ m n : ℤ, v = m • ((-4, 4, -1) : ℤ × ℤ × ℤ) + n • ((7, 0, -3) : ℤ × ℤ × ℤ) := by
  obtain ⟨a, b, c⟩ := v
  constructor
  · intro h
    rw [temper_apply] at h
    simp only at h
    refine ⟨b / 4, -((c + b / 4) / 3), ?_⟩
    simp only [Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk, Prod.mk.injEq]
    refine ⟨?_, ?_, ?_⟩ <;> omega
  · rintro ⟨m, n, h⟩
    rw [h, map_add, map_zsmul, map_zsmul, temper_commas.1, temper_commas.2]
    simp

/-- [proved-derived] The two commas are independent: the kernel has rank two. -/
theorem commas_independent (m n : ℤ)
    (h : m • ((-4, 4, -1) : ℤ × ℤ × ℤ) + n • ((7, 0, -3) : ℤ × ℤ × ℤ) = 0) : m = 0 ∧ n = 0 := by
  simp only [Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk, Prod.mk_eq_zero] at h
  obtain ⟨h1, h2, h3⟩ := h
  constructor <;> omega

/-- [proved-derived] The temperament is onto the steps: the quotient of the lattice by the commas is one line. -/
theorem temper_surjective : Function.Surjective temper := by
  intro k
  refine ⟨k • ((8, -5, 0) : ℤ × ℤ × ℤ), ?_⟩
  rw [map_zsmul]
  simp [temper_apply]

/-- [proved-derived] The Pythagorean comma `3¹² : 2¹⁹` is three syntonic commas less a diesis, and is in the kernel. -/
theorem pythagorean_in_kernel :
    ((-19, 12, 0) : ℤ × ℤ × ℤ) = (3 : ℤ) • ((-4, 4, -1) : ℤ × ℤ × ℤ) + (-1 : ℤ) • ((7, 0, -3) : ℤ × ℤ × ℤ) ∧
      temper (-19, 12, 0) = 0 := by
  constructor
  · simp
  · simp [temper_apply]

/-- [proved-derived] **A comma is no unison of the lattice**: a nonzero point of the kernel has a rational other than
one. The receiver's quotient closes it; the lattice does not. -/
theorem comma_ne_unison {v : ℤ × ℤ × ℤ} (hv : v ≠ 0) : interval v ≠ 1 := by
  intro h
  exact hv (interval_injective (h.trans interval_zero.symm))

/-! ## 3. The residuals -/

/-- `p/q < log₂ x` from `2^p < x^q`. -/
theorem div_lt_logb_two {x : ℝ} {p q : ℕ} (hq : 0 < q) (h : (2 : ℝ) ^ p < x ^ q) :
    (p : ℝ) / q < Real.logb 2 x := by
  have hq' : (0 : ℝ) < q := by exact_mod_cast hq
  rw [div_lt_iff₀ hq']
  have h1 : Real.logb 2 ((2 : ℝ) ^ p) < Real.logb 2 (x ^ q) :=
    Real.logb_lt_logb (by norm_num) (by positivity) h
  rw [Real.logb_pow, Real.logb_pow, Real.logb_self_eq_one (by norm_num)] at h1
  linarith

/-- `log₂ x < p/q` from `x^q < 2^p`. -/
theorem logb_two_lt_div {x : ℝ} (hx : 0 < x) {p q : ℕ} (hq : 0 < q) (h : x ^ q < (2 : ℝ) ^ p) :
    Real.logb 2 x < (p : ℝ) / q := by
  have hq' : (0 : ℝ) < q := by exact_mod_cast hq
  have hxq : 0 < x ^ q := pow_pos hx q
  rw [lt_div_iff₀ hq']
  have h1 : Real.logb 2 (x ^ q) < Real.logb 2 ((2 : ℝ) ^ p) :=
    Real.logb_lt_logb (by norm_num) hxq h
  rw [Real.logb_pow, Real.logb_pow, Real.logb_self_eq_one (by norm_num)] at h1
  linarith

/-- The same lower bound for a ratio of whole numbers, read on whole numbers: `2^p · b^q < a^q`. -/
theorem div_lt_logb_two_ratio {a b p q : ℕ} (hb : 0 < b) (hq : 0 < q) (h : 2 ^ p * b ^ q < a ^ q) :
    (p : ℝ) / q < Real.logb 2 ((a : ℝ) / b) := by
  have hb' : (0 : ℝ) < b := by exact_mod_cast hb
  apply div_lt_logb_two hq
  rw [div_pow, lt_div_iff₀ (pow_pos hb' q)]
  exact_mod_cast h

/-- The same upper bound for a ratio of whole numbers, read on whole numbers: `a^q < 2^p · b^q`. -/
theorem logb_two_ratio_lt_div {a b p q : ℕ} (ha : 0 < a) (hb : 0 < b) (hq : 0 < q) (h : a ^ q < 2 ^ p * b ^ q) :
    Real.logb 2 ((a : ℝ) / b) < (p : ℝ) / q := by
  have ha' : (0 : ℝ) < a := by exact_mod_cast ha
  have hb' : (0 : ℝ) < b := by exact_mod_cast hb
  apply logb_two_lt_div (div_pos ha' hb') hq
  rw [div_pow, div_lt_iff₀ (pow_pos hb' q)]
  exact_mod_cast h

/-- [proved-derived] **The tempered fifth stands under the just fifth**: `7/12 < log₂(3/2)`, which is `2¹⁹ < 3¹²`. -/
theorem fifth_flat : (7 : ℝ) / 12 < Real.logb 2 (3 / 2) := by
  have h := div_lt_logb_two_ratio (a := 3) (b := 2) (p := 7) (q := 12) (by norm_num) (by norm_num) (by norm_num)
  push_cast at h
  exact h

set_option exponentiation.threshold 1024 in
/-- [proved-derived] The fifth's residual is between `1/700` and `1/600` of an octave. -/
theorem fifth_residual :
    (1 : ℝ) / 700 < Real.logb 2 (3 / 2) - 7 / 12 ∧ Real.logb 2 (3 / 2) - 7 / 12 < 1 / 600 := by
  have h1 := div_lt_logb_two_ratio (a := 3) (b := 2) (p := 307) (q := 525) (by norm_num) (by norm_num)
    (by norm_num)
  have h2 := logb_two_ratio_lt_div (a := 3) (b := 2) (p := 117) (q := 200) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num)
  push_cast at h1 h2
  constructor <;> linarith

/-- [proved-derived] **The tempered major third stands over the just one**: `log₂(5/4) < 4/12`, which is `125 < 128`. -/
theorem third_sharp : Real.logb 2 (5 / 4) < (4 : ℝ) / 12 := by
  have h := logb_two_ratio_lt_div (a := 5) (b := 4) (p := 1) (q := 3) (by norm_num) (by norm_num) (by norm_num)
    (by norm_num)
  push_cast at h
  linarith

set_option exponentiation.threshold 1024 in
/-- [proved-derived] The major third's residual is between `1/100` and `1/80` of an octave. -/
theorem third_residual :
    (1 : ℝ) / 100 < 4 / 12 - Real.logb 2 (5 / 4) ∧ 4 / 12 - Real.logb 2 (5 / 4) < 1 / 80 := by
  have h1 := div_lt_logb_two_ratio (a := 5) (b := 4) (p := 77) (q := 240) (by norm_num) (by norm_num)
    (by norm_num)
  have h2 := logb_two_ratio_lt_div (a := 5) (b := 4) (p := 97) (q := 300) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num)
  push_cast at h1 h2
  constructor <;> linarith

/-! ## 4. Inversion: the same pairs, the opposite orientation -/

/-- [proved-standard] **Inversion reverses every pair's ratio.** -/
theorem inversion_pair {F : Type*} [Field F] (a b : F) : b⁻¹ / a⁻¹ = a / b := by
  rw [div_eq_mul_inv, inv_inv, mul_comm, div_eq_mul_inv]

variable {ι : Type*}

/-- A chord of whole tones inverted through its closing length: tone `i` becomes `lcm / a i`. -/
def inverted (s : Finset ι) (a : ι → ℕ) (i : ι) : ℕ := s.lcm a / a i

/-- [proved-standard] A tone times its inverted tone is the closing length. -/
theorem mul_inverted (s : Finset ι) (a : ι → ℕ) {i : ι} (hi : i ∈ s) : a i * inverted s a i = s.lcm a :=
  Nat.mul_div_cancel' (Finset.dvd_lcm hi)

private theorem lcm_ne_zero {s : Finset ι} {a : ι → ℕ} (ha : ∀ i ∈ s, a i ≠ 0) : s.lcm a ≠ 0 := by
  intro h
  obtain ⟨i, hi, h0⟩ := Finset.lcm_eq_zero_iff.mp h
  exact ha i hi h0

/-- [proved-standard] **The inverted chord shares no fundamental above one.** -/
theorem inverted_gcd (s : Finset ι) (a : ι → ℕ) (hs : s.Nonempty) (ha : ∀ i ∈ s, a i ≠ 0) :
    s.gcd (inverted s a) = 1 := by
  have hL0 : s.lcm a ≠ 0 := lcm_ne_zero ha
  set d := s.gcd (inverted s a) with hd
  have hdvd : ∀ i ∈ s, a i * d ∣ s.lcm a := by
    intro i hi
    have h1 : d ∣ inverted s a i := Finset.gcd_dvd hi
    have h2 := mul_dvd_mul_left (a i) h1
    rwa [mul_inverted s a hi] at h2
  obtain ⟨i0, hi0⟩ := hs
  have hdL : d ∣ s.lcm a := (dvd_mul_left d (a i0)).trans (hdvd i0 hi0)
  have hd0 : d ≠ 0 := by
    intro h
    rw [h] at hdL
    exact hL0 (zero_dvd_iff.mp hdL)
  have h2 : ∀ i ∈ s, a i ∣ s.lcm a / d := by
    intro i hi
    obtain ⟨k, hk⟩ := hdvd i hi
    refine ⟨k, ?_⟩
    rw [hk, mul_assoc, mul_comm d k, ← mul_assoc, Nat.mul_div_cancel _ (Nat.pos_of_ne_zero hd0)]
  have h3 : s.lcm a ∣ s.lcm a / d := Finset.lcm_dvd h2
  have hpos : 0 < s.lcm a / d :=
    Nat.div_pos (Nat.le_of_dvd (Nat.pos_of_ne_zero hL0) hdL) (Nat.pos_of_ne_zero hd0)
  have h4 : s.lcm a ≤ s.lcm a / d := Nat.le_of_dvd hpos h3
  have h5 : s.lcm a / d * d = s.lcm a := Nat.div_mul_cancel hdL
  have hLpos : 0 < s.lcm a := Nat.pos_of_ne_zero hL0
  have hd1 : 1 ≤ d := Nat.pos_of_ne_zero hd0
  by_contra hne
  have hd2 : 2 ≤ d := by omega
  nlinarith

/-- [proved-standard] **The inverted chord closes at the closing length over the shared fundamental**: inversion
exchanges the shared fundamental with the shared overtone. -/
theorem inverted_lcm (s : Finset ι) (a : ι → ℕ) (hs : s.Nonempty) (ha : ∀ i ∈ s, a i ≠ 0) :
    s.lcm (inverted s a) = s.lcm a / s.gcd a := by
  have hL0 : s.lcm a ≠ 0 := lcm_ne_zero ha
  obtain ⟨i0, hi0⟩ := hs
  have hg0 : s.gcd a ≠ 0 := by
    intro h
    exact ha i0 hi0 ((Finset.gcd_eq_zero_iff.mp h) i0 hi0)
  have hgpos : 0 < s.gcd a := Nat.pos_of_ne_zero hg0
  have hgL : s.gcd a ∣ s.lcm a := (Finset.gcd_dvd hi0).trans (Finset.dvd_lcm hi0)
  apply Nat.dvd_antisymm
  · refine Finset.lcm_dvd fun i hi => ?_
    obtain ⟨k, hk⟩ : s.gcd a ∣ a i := Finset.gcd_dvd hi
    refine ⟨k, ?_⟩
    have h1 : s.lcm a = inverted s a i * k * s.gcd a := by
      rw [← mul_inverted s a hi]
      nth_rewrite 1 [hk]
      ring
    rw [h1, Nat.mul_div_cancel _ hgpos]
  · have h1 : ∀ i ∈ s, s.lcm a ∣ s.lcm (inverted s a) * a i := by
      intro i hi
      have h2 : inverted s a i ∣ s.lcm (inverted s a) := Finset.dvd_lcm hi
      have h3 := mul_dvd_mul_right h2 (a i)
      rwa [mul_comm (inverted s a i), mul_inverted s a hi] at h3
    have h2 : s.lcm a ∣ s.gcd fun i => s.lcm (inverted s a) * a i := Finset.dvd_gcd h1
    rw [Finset.gcd_mul_left] at h2
    simp only [normalize_eq] at h2
    have h3 : s.lcm a / s.gcd a * s.gcd a ∣ s.lcm (inverted s a) * s.gcd a := by
      rwa [Nat.div_mul_cancel hgL]
    exact Nat.dvd_of_mul_dvd_mul_right hgpos h3

/-- The major triad `4 : 5 : 6`. -/
def major : Fin 3 → ℕ := ![4, 5, 6]

/-- The minor triad `10 : 12 : 15`. -/
def minor : Fin 3 → ℕ := ![10, 12, 15]

/-- [proved-derived] **`4 : 5 : 6` inverts to `15 : 12 : 10`**, the minor triad read downward. -/
theorem minor_is_inverted_major : inverted Finset.univ major = ![15, 12, 10] := by decide

/-- [proved-derived] Both triads share the fundamental one and close at sixty, which is fifteen times the lowest tone of
the first and six times the lowest of the second. -/
theorem major_minor_closing :
    Finset.univ.gcd major = 1 ∧ Finset.univ.lcm major = 60 ∧ Finset.univ.gcd minor = 1 ∧
      Finset.univ.lcm minor = 60 ∧ 60 = 15 * major 0 ∧ 60 = 6 * minor 0 := by decide

/-- [proved-derived] **The same three pairwise ratios, the lower two exchanged**: `5:4`, `6:5` and `3:2`. -/
theorem major_minor_pairs :
    ((5 : ℚ) / 4 = 15 / 12 ∧ (6 : ℚ) / 5 = 12 / 10 ∧ (6 : ℚ) / 4 = 15 / 10) ∧
      ((10 : ℚ) = 60 / 6 ∧ (12 : ℚ) = 60 / 5 ∧ (15 : ℚ) = 60 / 4) := by
  norm_num

/-- [proved-derived] **The third body separates them**: no scale takes `4 : 5 : 6` to `10 : 12 : 15`. -/
theorem major_minor_differ : ¬ ∃ c : ℚ, c * 4 = 10 ∧ c * 5 = 12 ∧ c * 6 = 15 := by
  rintro ⟨c, h1, h2, _⟩
  linarith

end Holonics.Mathematics.Chord
