import HolonicsResearch.Mathematics.ColourScope
import Mathlib.NumberTheory.DirichletCharacter.GaussSum
import Mathlib.GroupTheory.FiniteAbelian.Duality
import Mathlib.RingTheory.Polynomial.Cyclotomic.Roots
import Mathlib.RingTheory.RootsOfUnity.AlgebraicallyClosed
import Mathlib.Analysis.Complex.Polynomial.Basic

/-!
# A scope reads neutral only where it holds a repeated prime's fibre

[proved-standard; formal-checked] The source is #410's box "The neutral criterion" (p), the record of October 26 in
`research/records/` (§4, §8, §10(p)),
`2026-10-26_NEUTRAL_IS_A_RATIO_OF_ONE_AGAINST_WHERE_THE_RECEIVER_STANDS_AND_THE_SCOPE_DECIDES_WHAT_A_COLOUR_READS.md`,
and atlas `colour.neutral-fibre`. A scope `H ≤ (ℤ/n)ˣ` reads the colour `ζ_n` as `Tr_H(ζ_n) = ∑_(h ∈ H) ζ_n^h`
(`scopeReading` in `Mathematics/ColourScope`). For a prime `p` with `p² ∣ n`, write `K_p` for the kernel of
`(ℤ/n)ˣ → (ℤ/(n/p))ˣ`, the fibre of `p`. `Mathematics/ColourScope` proves that a scope holding some `K_p` reads `0`
(`scopeReading_eq_zero_of_ker_le`). This module proves the converse, so the criterion holds both ways.

What is proved.

1. **A neutral scope is neutral on every coset** (`cosetReading`, `coset_readings_eq_zero`): if `Tr_H(ζ) = 0`, then
   `∑_(h ∈ H) ζ^(g h) = 0` for every unit `g`. The polynomial `∑_(h ∈ H) X^h` over `ℚ` vanishes at `ζ`, so the
   cyclotomic polynomial, the minimal polynomial of every primitive `n`-th root, divides it, and it vanishes at `ζ^g`.
2. **Then every character trivial on the scope has Gauss sum `0`** (`gaussSum_eq_sum_units`,
   `charSum_eq_zero_of_neutral`): for a Dirichlet character `χ` mod `n` with `χ = 1` on `H`, the sum
   `τ(χ) = ∑_u χ(u) ζ^u` equals `|H|⁻¹ ∑_u χ(u) ∑_(h ∈ H) ζ^(u h)`, a sum of coset readings.
3. **A character that sees every fibre** (`pow_ne_one_of_prime`, `exists_hom_ne_one_of_primes`, `fibre_split`,
   `fibreUnit`, `fibreUnit_val`, `fibreUnit_pow`, `fibreUnit_mem_ker`, `ker_le_of_fibreUnit_mem`,
   `exists_char_ne_one_on_fibres`): `K_p` is generated by `g_p = 1 + n/p` (every `u ≡ 1 mod n/p` is a power of it),
   and `g_p^p = 1`. If no `K_p` lies in `H`, the images of the `g_p` in `(ℤ/n)ˣ ⧸ H` have distinct prime orders,
   and one character of the quotient is `≠ 1` at all of them: from `ψ₀`, `≠ 1` at the primes of a set `s`, and `ψ_q`,
   `≠ 1` at `q`, the character `ψ₀^q · ψ_q^(∏_(p ∈ s) p)` is `≠ 1` at the primes of `s ∪ {q}`. Pulled back, it is a
   Dirichlet character trivial on `H` that factors through no `n/p` with `p² ∣ n`.
4. **That character's Gauss sum is not `0`** (`gaussSum_ne_zero_of_isPrimitive`, `isPrimitive_of_not_factorsThrough`,
   `gaussSum_changeLevel_prime_mul`, `gaussSum_ne_zero_of_fibres`), for every primitive additive character `ψ` of
   `ℤ/n`. A primitive `χ` has `τ(χ, ψ_a) = χ⁻¹(a) τ(χ, ψ)` for the shifts `ψ_a = ψ(a ·)`, while
   `∑_a ψ(−a) τ(χ, ψ_a) = n χ(1) = n`, so `τ(χ, ψ) ≠ 0`. Where `n = p k` with `p ∤ k` and `χ` comes from `χ'` mod `k`,
   the pair `ℤ/(p k) ≅ ℤ/p × ℤ/k` splits `ψ`, and `τ(χ, ψ) = −τ(χ', ψ')` with `ψ'` primitive: the `−1` is
   `∑_(c ≠ 0) ψ(c, 0)`. By strong induction on `n`, peeling such primes, `τ(χ, ψ) ≠ 0` whenever `χ` factors through
   no `n/p` with `p² ∣ n`; once no prime is left to peel, `χ` factors through no `n/p` at all and is primitive.
5. **The neutral criterion** (`scopeReading_eq_zero_iff`): `Tr_H(ζ_n) = 0` if and only if `n = p·m` with `p` prime,
   `p ∣ m` and `ker((ℤ/n)ˣ → (ℤ/m)ˣ) ≤ H`. `⇐` is `scopeReading_eq_zero_of_ker_le`; `⇒` joins 1 to 4: a neutral
   scope holding no fibre would carry a character whose Gauss sum is `0` (1, 2) and not `0` (3, 4).

What is not claimed. The size of a reading that is not neutral, and the value of `|τ(χ)|` (classically `√n` for a
primitive `χ`, divided by the root of each peeled prime), are not stated: only that `τ(χ) ≠ 0`. The statement is for
`ζ` in `ℂ`, where `scopeReading` lives. The Ramanujan-sum route of the box's brief was not needed and is not
formalized. The census counts (`n ≤ 200` in the record, every subgroup for `n ≤ 260` in the brief) are readings, not
theorems here.

The computational object is the helical pair interaction: a colour read through the scope's turns, each unit `h` a
turn of the ring `ζ`, and a character `χ` of the turns read against the ring's own additive character `ψ` in the
Gauss sum `∑ χ(u) ψ(u)`. Of the winding guide's six general objects this touches the helix (`ζ^h` reads `h` only
modulo the ring's period `n`), the pair (the coprime frames `ℤ/p` and `ℤ/k` meet once per residue pair modulo `p k`,
which splits the Gauss sum), faces and placement (the scope's reading is the face that `H` fixes, the coset readings
are its conjugate faces) and the tower thread (`K_p` is the fibre of the restriction from level `n` to level `n/p`,
and the induction descends the levels one peeled prime at a time); cell holonomy and the tube stay attached.

Consumers: #410's box "The neutral criterion" (p); atlas `colour.neutral-fibre`.

No `sorry`, no `axiom`, no `native_decide`.
-/

namespace Holonics.Mathematics.NeutralCriterion

open Finset Polynomial DirichletCharacter
open Holonics.Mathematics.ColourScope

/-! ## 1. A neutral scope is neutral on every coset -/

/-- [definition] The coset reading `Tr_(gH)(ζ) = ∑_(h ∈ H) ζ^(g h)`. -/
noncomputable def cosetReading {n : ℕ} [NeZero n] (H : Subgroup (ZMod n)ˣ)
    [DecidablePred (· ∈ H)] (ζ : ℂ) (g : (ZMod n)ˣ) : ℂ :=
  ∑ h : H, ζ ^ ((g * h : (ZMod n)ˣ) : ZMod n).val

/-- [proved-standard; formal-checked] **A neutral scope is neutral on every coset:** if `Tr_H(ζ_n) = 0`, then
`Tr_(gH)(ζ_n) = 0` for every unit `g`. -/
theorem coset_readings_eq_zero {n : ℕ} [NeZero n] {ζ : ℂ} (hζ : IsPrimitiveRoot ζ n)
    (H : Subgroup (ZMod n)ˣ) [DecidablePred (· ∈ H)] (h0 : scopeReading H ζ = 0)
    (g : (ZMod n)ˣ) : cosetReading H ζ g = 0 := by
  have hn : 0 < n := Nat.pos_of_ne_zero (NeZero.ne n)
  let P : ℚ[X] := ∑ h : H, X ^ ((h : (ZMod n)ˣ) : ZMod n).val
  have hP : aeval ζ P = 0 := by
    simpa [P, scopeReading, map_sum] using h0
  have hg : IsPrimitiveRoot (ζ ^ (g : ZMod n).val) n :=
    hζ.pow_of_coprime _ (ZMod.val_coe_unit_coprime g)
  have hmin : minpoly ℚ (ζ ^ (g : ZMod n).val) = minpoly ℚ ζ := by
    rw [← cyclotomic_eq_minpoly_rat hg hn, ← cyclotomic_eq_minpoly_rat hζ hn]
  obtain ⟨Q, hQ⟩ := minpoly.dvd ℚ ζ hP
  have hPg : aeval (ζ ^ (g : ZMod n).val) P = 0 := by
    rw [hQ, map_mul, ← hmin, minpoly.aeval, zero_mul]
  rw [← hPg]
  simp only [P, cosetReading, map_sum, map_pow, aeval_X, ← pow_mul]
  refine Finset.sum_congr rfl fun h _ => ?_
  rw [Units.val_mul, ZMod.val_mul, ← pow_eq_pow_mod _ hζ.pow_eq_one]

/-! ## 2. Every character trivial on a neutral scope has Gauss sum zero -/

/-- [proved-standard; formal-checked] **A Gauss sum is a sum over the units:** a Dirichlet character vanishes off
them. -/
theorem gaussSum_eq_sum_units {n : ℕ} [NeZero n] (χ : DirichletCharacter ℂ n)
    (ψ : AddChar (ZMod n) ℂ) : gaussSum χ ψ = ∑ u : (ZMod n)ˣ, χ u * ψ u := by
  classical
  rw [gaussSum]
  symm
  have hmap := Finset.sum_map univ ⟨((↑) : (ZMod n)ˣ → ZMod n), Units.val_injective⟩
    (fun a => χ a * ψ a)
  simp only [Function.Embedding.coeFn_mk] at hmap
  rw [← hmap]
  refine Finset.sum_subset (subset_univ _) fun a _ ha => ?_
  have hu : ¬ IsUnit a := by
    rintro ⟨u, rfl⟩
    exact ha (mem_map.2 ⟨u, mem_univ _, rfl⟩)
  rw [MulChar.map_nonunit χ hu, zero_mul]

/-- [proved-standard; formal-checked] **A character trivial on a neutral scope has Gauss sum `0`:** if
`Tr_H(ζ_n) = 0` and `χ = 1` on `H`, then `∑_u χ(u) ζ_n^u = 0`. -/
theorem charSum_eq_zero_of_neutral {n : ℕ} [NeZero n] {ζ : ℂ} (hζ : IsPrimitiveRoot ζ n)
    (H : Subgroup (ZMod n)ˣ) [DecidablePred (· ∈ H)] (h0 : scopeReading H ζ = 0)
    (χ : DirichletCharacter ℂ n) (hχ : ∀ h ∈ H, χ (h : ZMod n) = 1) :
    gaussSum χ (AddChar.zmodChar n hζ.pow_eq_one) = 0 := by
  rw [gaussSum_eq_sum_units]
  simp only [AddChar.zmodChar_apply]
  have hshift : ∀ h : H, ∑ u : (ZMod n)ˣ, χ u * ζ ^ ((u * h : (ZMod n)ˣ) : ZMod n).val =
      ∑ u : (ZMod n)ˣ, χ u * ζ ^ (u : ZMod n).val := by
    intro h
    calc _ = ∑ u : (ZMod n)ˣ, χ ((u * h : (ZMod n)ˣ) : ZMod n) *
          ζ ^ ((u * h : (ZMod n)ˣ) : ZMod n).val := by
          refine sum_congr rfl fun u _ => ?_
          rw [Units.val_mul, map_mul, hχ h h.2, mul_one]
      _ = _ := Fintype.sum_equiv (Equiv.mulRight (h : (ZMod n)ˣ)) _ _ fun u => rfl
  have hcard : (Fintype.card H : ℂ) * ∑ u : (ZMod n)ˣ, χ u * ζ ^ (u : ZMod n).val = 0 := by
    calc (Fintype.card H : ℂ) * ∑ u : (ZMod n)ˣ, χ u * ζ ^ (u : ZMod n).val
        = ∑ h : H, ∑ u : (ZMod n)ˣ, χ u * ζ ^ ((u * h : (ZMod n)ˣ) : ZMod n).val := by
          rw [← nsmul_eq_mul, ← Finset.card_univ, ← Finset.sum_const]
          exact sum_congr rfl fun h _ => (hshift h).symm
      _ = ∑ u : (ZMod n)ˣ, χ u * cosetReading H ζ u := by
          rw [sum_comm]
          simp only [cosetReading, mul_sum]
      _ = 0 := by simp [coset_readings_eq_zero hζ H h0]
  have hc : (Fintype.card H : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr Fintype.card_ne_zero
  exact (mul_eq_zero.mp hcard).resolve_left hc

/-! ## 3. A character that sees every fibre -/

/-- [proved-standard; formal-checked] **A root of prime order survives a power prime to it:** if `z^p = 1`,
`z ≠ 1`, `p` prime and `p ∤ k`, then `z^k ≠ 1`. -/
theorem pow_ne_one_of_prime {M : Type*} [Monoid M] {z : M} {p k : ℕ} (hp : p.Prime)
    (hz : z ^ p = 1) (hz1 : z ≠ 1) (hk : ¬ p ∣ k) : z ^ k ≠ 1 := by
  intro hzk
  have hord : orderOf z = p :=
    ((Nat.Prime.eq_one_or_self_of_dvd hp _ (orderOf_dvd_of_pow_eq_one hz)).resolve_left
      (fun h => hz1 (orderOf_eq_one_iff.mp h)))
  exact hk (hord ▸ orderOf_dvd_of_pow_eq_one hzk)

/-- [proved-standard; formal-checked] **One character sees elements of distinct prime orders:** in a finite
commutative group, if `a_p^p = 1` and `a_p ≠ 1` for each prime `p` of a finite set, one character `ψ` into `ℂˣ`
has `ψ(a_p) ≠ 1` for all of them. -/
theorem exists_hom_ne_one_of_primes {A : Type*} [CommGroup A] [Finite A] (s : Finset ℕ)
    (a : ℕ → A) (hs : ∀ p ∈ s, p.Prime) (ha : ∀ p ∈ s, a p ^ p = 1)
    (ha1 : ∀ p ∈ s, a p ≠ 1) : ∃ ψ : A →* ℂˣ, ∀ p ∈ s, ψ (a p) ≠ 1 := by
  classical
  induction s using Finset.induction_on with
  | empty => exact ⟨1, by simp⟩
  | insert q s hq ih =>
    obtain ⟨ψ₀, hψ₀⟩ := ih (fun p hp => hs p (mem_insert_of_mem hp))
      (fun p hp => ha p (mem_insert_of_mem hp)) (fun p hp => ha1 p (mem_insert_of_mem hp))
    have : NeZero (Monoid.exponent A) := ⟨Monoid.exponent_ne_zero_of_finite⟩
    obtain ⟨ψq, hψq⟩ :=
      CommGroup.exists_apply_ne_one_of_hasEnoughRootsOfUnity A ℂ (ha1 q (mem_insert_self q s))
    have hqp : q.Prime := hs q (mem_insert_self q s)
    have hqN : ¬ q ∣ ∏ p ∈ s, p := by
      intro h
      obtain ⟨p, hp, hqp'⟩ := (Prime.dvd_finsetProd_iff hqp.prime _).mp h
      have := (Nat.prime_dvd_prime_iff_eq hqp (hs p (mem_insert_of_mem hp))).mp hqp'
      exact hq (this ▸ hp)
    refine ⟨ψ₀ ^ q * ψq ^ (∏ p ∈ s, p), fun p hp => ?_⟩
    rw [MonoidHom.mul_apply, MonoidHom.pow_apply, MonoidHom.pow_apply]
    rcases mem_insert.mp hp with rfl | hps
    · rw [← map_pow, ha p hp, map_one, one_mul]
      exact pow_ne_one_of_prime hqp (by rw [← map_pow, ha p hp, map_one]) hψq hqN
    · have hpq : p ≠ q := fun h => hq (h ▸ hps)
      have hpp : p.Prime := hs p hp
      have h1 : ψq (a p) ^ (∏ p ∈ s, p) = 1 := by
        obtain ⟨t, ht⟩ := dvd_prod_of_mem (fun p => p) hps
        rw [ht, pow_mul, ← map_pow, ha p hp, map_one, one_pow]
      rw [h1, mul_one]
      refine pow_ne_one_of_prime hpp (by rw [← map_pow, ha p hp, map_one]) (hψ₀ p hps) ?_
      intro h
      exact hpq ((Nat.prime_dvd_prime_iff_eq hpp hqp).mp h)

/-- [proved-standard; formal-checked] **A repeated prime splits its level:** `p² ∣ n` gives `n = p · (n/p)` with
`p ∣ n/p`. -/
theorem fibre_split {n p : ℕ} (hpp : p ^ 2 ∣ n) : n = p * (n / p) ∧ p ∣ n / p :=
  ⟨(Nat.mul_div_cancel' ((dvd_pow_self p two_ne_zero).trans hpp)).symm,
    Nat.dvd_div_of_mul_dvd (by rwa [← pow_two])⟩

/-- [definition] The fibre generator `g_p = 1 + n/p`, a unit of `ZMod n` when `p² ∣ n` (its inverse is
`1 − n/p`, since `(n/p)² ≡ 0`). -/
noncomputable def fibreUnit {n p : ℕ} (hpp : p ^ 2 ∣ n) : (ZMod n)ˣ :=
  have hsq : ((n / p : ℕ) : ZMod n) * ((n / p : ℕ) : ZMod n) = 0 :=
    fibre_step_sq (fibre_split hpp).1 (fibre_split hpp).2
  ⟨1 + ((n / p : ℕ) : ZMod n), 1 - ((n / p : ℕ) : ZMod n), by linear_combination -hsq,
    by linear_combination -hsq⟩

/-- [proved-standard; formal-checked] The fibre generator reads `1 + n/p`. -/
theorem fibreUnit_val {n p : ℕ} (hpp : p ^ 2 ∣ n) :
    (fibreUnit hpp : ZMod n) = 1 + ((n / p : ℕ) : ZMod n) := rfl

/-- [proved-standard; formal-checked] **The fibre closes after `p` steps:** `g_p^p = 1`. -/
theorem fibreUnit_pow {n p : ℕ} (hpp : p ^ 2 ∣ n) : fibreUnit hpp ^ p = 1 := by
  ext
  rw [fibre_generator_pow (fibre_split hpp).1 (fibre_split hpp).2 (fibreUnit_val hpp) p,
    Units.val_one, ← Nat.cast_mul, ← (fibre_split hpp).1, ZMod.natCast_self, add_zero]

/-- [proved-standard; formal-checked] **The fibre generator lies in the fibre** `K_p`. -/
theorem fibreUnit_mem_ker {n p : ℕ} (hpp : p ^ 2 ∣ n) (hd : n / p ∣ n) :
    fibreUnit hpp ∈ (ZMod.unitsMap hd).ker :=
  fibre_generator_mem_ker hd (fibreUnit_val hpp)

/-- [proved-standard; formal-checked] **The fibre generator generates the fibre:** a scope holding `g_p` holds
all of `K_p`, since every `u ≡ 1 mod n/p` is `g_p^j` for some `j`. -/
theorem ker_le_of_fibreUnit_mem {n p : ℕ} [NeZero n] (hp : p.Prime) (hpp : p ^ 2 ∣ n)
    (hd : n / p ∣ n) (H : Subgroup (ZMod n)ˣ) (hg : fibreUnit hpp ∈ H) :
    (ZMod.unitsMap hd).ker ≤ H := by
  intro u hu
  obtain ⟨hn, hpm⟩ := fibre_split hpp
  have hn1 : n ≠ 1 := by
    rintro rfl
    exact hp.one_lt.ne' (Nat.pow_eq_one.mp (Nat.dvd_one.mp hpp) |>.resolve_right two_ne_zero)
  have : Nontrivial (ZMod n) := ZMod.nontrivial_iff.mpr hn1
  rw [MonoidHom.mem_ker, Units.ext_iff, ZMod.unitsMap_val, Units.val_one, ZMod.cast_eq_val] at hu
  have hv1 : 1 ≤ (u : ZMod n).val :=
    Nat.one_le_iff_ne_zero.mpr ((ZMod.val_eq_zero _).not.mpr u.ne_zero)
  have hmod : 1 ≡ (u : ZMod n).val [MOD n / p] := by
    rw [← ZMod.natCast_eq_natCast_iff, hu, Nat.cast_one]
  obtain ⟨j, hj⟩ := (Nat.modEq_iff_dvd' hv1).mp hmod
  have hu' : u = fibreUnit hpp ^ j := by
    ext
    rw [fibre_generator_pow hn hpm (fibreUnit_val hpp) j, ← ZMod.natCast_zmod_val (u : ZMod n),
      show (u : ZMod n).val = 1 + n / p * j by omega]
    push_cast
    ring
  rw [hu']
  exact H.pow_mem hg j

/-- [proved-standard; formal-checked] **A character that sees every fibre:** if a scope `H` holds no fibre
generator `g_p` (`p` prime, `p² ∣ n`), some Dirichlet character mod `n` is `1` on `H` and factors through no
`n/p` with `p² ∣ n`. -/
theorem exists_char_ne_one_on_fibres {n : ℕ} [NeZero n] (H : Subgroup (ZMod n)ˣ)
    (hH : ∀ p, p.Prime → ∀ hpp : p ^ 2 ∣ n, fibreUnit hpp ∉ H) :
    ∃ χ : DirichletCharacter ℂ n, (∀ h ∈ H, χ (h : ZMod n) = 1) ∧
      ∀ p, p.Prime → p ^ 2 ∣ n → ¬ χ.FactorsThrough (n / p) := by
  classical
  let s := (range (n + 1)).filter (fun p => p.Prime ∧ p ^ 2 ∣ n)
  let a : ℕ → (ZMod n)ˣ ⧸ H := fun p =>
    if h : p ^ 2 ∣ n then (QuotientGroup.mk (fibreUnit h) : (ZMod n)ˣ ⧸ H) else 1
  have ha : ∀ p (h : p ^ 2 ∣ n), a p = QuotientGroup.mk (fibreUnit h) := fun p h => dif_pos h
  obtain ⟨ψ, hψ⟩ := exists_hom_ne_one_of_primes s a (fun p hp => (mem_filter.1 hp).2.1)
    (fun p hp => by
      rw [ha p (mem_filter.1 hp).2.2, ← QuotientGroup.mk_pow, fibreUnit_pow, QuotientGroup.mk_one])
    (fun p hp => by
      rw [ha p (mem_filter.1 hp).2.2, Ne, QuotientGroup.eq_one_iff]
      exact hH p (mem_filter.1 hp).2.1 _)
  refine ⟨MulChar.ofUnitHom (ψ.comp (QuotientGroup.mk' H)), fun h hh => ?_,
    fun p hp hpp hf => ?_⟩
  · rw [MulChar.ofUnitHom_coe, MonoidHom.comp_apply, QuotientGroup.mk'_apply,
      (QuotientGroup.eq_one_iff h).2 hh, map_one, Units.val_one]
  · have hd : n / p ∣ n := Nat.div_dvd_of_dvd ((dvd_pow_self p two_ne_zero).trans hpp)
    rw [factorsThrough_iff_ker_unitsMap hd] at hf
    have hmem := hf (fibreUnit_mem_ker hpp hd)
    rw [MonoidHom.mem_ker] at hmem
    have hps : p ∈ s := mem_filter.2 ⟨mem_range.2 (Nat.lt_succ_of_le (Nat.le_of_dvd
      (Nat.pos_of_ne_zero (NeZero.ne n)) ((dvd_pow_self p two_ne_zero).trans hpp))), hp, hpp⟩
    apply hψ p hps
    rw [ha p hpp]
    have h2 : ((ψ.comp (QuotientGroup.mk' H)) (fibreUnit hpp) : ℂ) = 1 := by
      rw [← MulChar.ofUnitHom_coe, ← MulChar.coe_toUnitHom, hmem, Units.val_one]
    exact Units.ext h2

/-! ## 4. A character that sees every fibre has a Gauss sum that is not zero -/

/-- [proved-standard; formal-checked] **A primitive character's Gauss sum is not `0`** against a primitive
additive character of `ℤ/n`. -/
theorem gaussSum_ne_zero_of_isPrimitive {n : ℕ} [NeZero n] {χ : DirichletCharacter ℂ n}
    (hχ : χ.IsPrimitive) {ψ : AddChar (ZMod n) ℂ} (hψ : ψ.IsPrimitive) : gaussSum χ ψ ≠ 0 := by
  classical
  intro h0
  have key : ∑ a : ZMod n, ψ (-a) * gaussSum χ (ψ.mulShift a) = n := by
    simp only [gaussSum, AddChar.mulShift_apply, Finset.mul_sum]
    rw [Finset.sum_comm]
    have hx : ∀ x : ZMod n, ∑ a : ZMod n, ψ (-a) * (χ x * ψ (a * x)) =
        χ x * ∑ a : ZMod n, ψ (a * (x - 1)) := by
      intro x
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [mul_sub, mul_one, sub_eq_neg_add, AddChar.map_add_eq_mul]
      ring
    simp_rw [hx, AddChar.sum_mulShift _ hψ, sub_eq_zero]
    simp_rw [Nat.cast_ite, Nat.cast_zero, mul_ite, mul_zero]
    rw [Finset.sum_ite_eq' univ (1 : ZMod n), if_pos (mem_univ _), MulChar.map_one, one_mul,
      ZMod.card]
  have hzero : ∀ a : ZMod n, gaussSum χ (ψ.mulShift a) = 0 := fun a => by
    rw [gaussSum_mulShift_of_isPrimitive ψ hχ a, h0, mul_zero]
  simp only [hzero, mul_zero, Finset.sum_const_zero] at key
  exact NeZero.ne n (by exact_mod_cast key.symm)

/-- [proved-standard; formal-checked] **A character that factors through no `n/p` is primitive.** -/
theorem isPrimitive_of_not_factorsThrough {n : ℕ} [NeZero n] (χ : DirichletCharacter ℂ n)
    (h : ∀ p, p.Prime → p ∣ n → ¬ χ.FactorsThrough (n / p)) : χ.IsPrimitive := by
  rw [isPrimitive_def]
  by_contra hc
  have hfc := factorsThrough_conductor χ
  obtain ⟨k, hk⟩ := conductor_dvd_level χ
  generalize χ.conductor = c at hk hc hfc
  have hk1 : k ≠ 1 := by rintro rfl; exact hc (by rw [hk, mul_one])
  obtain ⟨p, hp, hpk⟩ := Nat.exists_prime_and_dvd hk1
  obtain ⟨t, rfl⟩ := hpk
  have hpn : p ∣ n := ⟨c * t, by rw [hk]; ring⟩
  have hnp : n / p = c * t := by
    rw [hk, show c * (p * t) = p * (c * t) by ring, Nat.mul_div_cancel_left _ hp.pos]
  exact h p hp hpn (FactorsThrough.mono χ hfc ⟨t, hnp⟩ (Nat.div_dvd_of_dvd hpn))

/-- [proved-standard; formal-checked] **Peeling a prime that divides the level once:** if `p ∤ k` and `χ` mod
`p k` comes from `χ'` mod `k`, then `τ(χ, ψ) = −τ(χ', ψ')` for a primitive `ψ'` of `ℤ/k`, through the pair
`ℤ/(p k) ≅ ℤ/p × ℤ/k`. -/
theorem gaussSum_changeLevel_prime_mul {p k : ℕ} [NeZero k] [NeZero (p * k)] (hp : p.Prime)
    (hpk : Nat.Coprime p k) (hdvd : k ∣ p * k) (χ' : DirichletCharacter ℂ k)
    {ψ : AddChar (ZMod (p * k)) ℂ} (hψ : ψ.IsPrimitive) :
    ∃ ψ' : AddChar (ZMod k) ℂ, ψ'.IsPrimitive ∧
      gaussSum (changeLevel hdvd χ') ψ = -gaussSum χ' ψ' := by
  classical
  have : Fact p.Prime := ⟨hp⟩
  let e := ZMod.chineseRemainder hpk
  have he2 : ∀ a : ZMod (p * k), (e a).2 = ZMod.cast a := by
    intro a
    have : (RingHom.snd (ZMod p) (ZMod k)).comp e.toRingHom = ZMod.castHom hdvd (ZMod k) :=
      Subsingleton.elim _ _
    exact RingHom.congr_fun this a
  let ψ₁ : AddChar (ZMod p) ℂ :=
    ψ.compAddMonoidHom (e.symm.toAddMonoidHom.comp (AddMonoidHom.inl _ _))
  let ψ₂ : AddChar (ZMod k) ℂ :=
    ψ.compAddMonoidHom (e.symm.toAddMonoidHom.comp (AddMonoidHom.inr _ _))
  have hsplit : ∀ x : ZMod p × ZMod k, ψ (e.symm x) = ψ₁ x.1 * ψ₂ x.2 := by
    rintro ⟨c, b⟩
    simp only [ψ₁, ψ₂, AddChar.compAddMonoidHom_apply, AddMonoidHom.coe_comp,
      Function.comp_apply, AddMonoidHom.inl_apply, AddMonoidHom.inr_apply,
      ← AddChar.map_add_eq_mul, ← map_add, Prod.mk_add_mk, add_zero, zero_add]
    rfl
  have hmul : ∀ (x : ZMod p × ZMod k) (y : ZMod (p * k)), e.symm x * y = e.symm (x * e y) := by
    intro x y; rw [map_mul, RingEquiv.symm_apply_apply]
  have hne : ∀ x : ZMod p × ZMod k, x ≠ 0 → e.symm x ≠ 0 := by
    intro x hx h
    exact hx (by simpa using congrArg e h)
  have hψ₁ : ψ₁ ≠ 1 := by
    obtain ⟨y, hy⟩ := AddChar.ne_one_iff.1 (hψ (hne (1, 0) (by simp)))
    refine AddChar.ne_one_iff.2 ⟨(e y).1, ?_⟩
    rw [AddChar.mulShift_apply, hmul, show ((1, 0) * e y : ZMod p × ZMod k) = ((e y).1, 0) by
      ext <;> simp] at hy
    exact hy
  have hψ₂ : ψ₂.IsPrimitive := by
    intro b hb
    obtain ⟨y, hy⟩ := AddChar.ne_one_iff.1 (hψ (hne (0, b) (by simp [hb])))
    refine AddChar.ne_one_iff.2 ⟨(e y).2, ?_⟩
    rw [AddChar.mulShift_apply, hmul, show ((0, b) * e y : ZMod p × ZMod k) = (0, b * (e y).2) by
      ext <;> simp] at hy
    exact hy
  have hχ : ∀ x : ZMod p × ZMod k,
      changeLevel hdvd χ' (e.symm x) = if x.1 = 0 then 0 else χ' x.2 := by
    rintro ⟨c, b⟩
    by_cases hc : c = 0
    · rw [if_pos hc]
      apply MulChar.map_nonunit
      intro hu
      have h2 := hu.map e
      rw [RingEquiv.apply_symm_apply, Prod.isUnit_iff, hc] at h2
      exact not_isUnit_zero h2.1
    · rw [if_neg hc]
      by_cases hb : IsUnit b
      · have hu : IsUnit (e.symm (c, b)) :=
          (Prod.isUnit_iff.2 ⟨isUnit_iff_ne_zero.2 hc, hb⟩).map e.symm
        rw [← hu.unit_spec, changeLevel_eq_cast_of_dvd, hu.unit_spec, ← he2,
          RingEquiv.apply_symm_apply]
      · rw [MulChar.map_nonunit χ' hb]
        apply MulChar.map_nonunit
        intro hu
        have h2 := hu.map e
        rw [RingEquiv.apply_symm_apply, Prod.isUnit_iff] at h2
        exact hb h2.2
  refine ⟨ψ₂, hψ₂, ?_⟩
  have hrow : ∀ c : ZMod p, ∑ b : ZMod k, (if c = 0 then 0 else χ' b) * (ψ₁ c * ψ₂ b) =
      (if c = 0 then 0 else ψ₁ c) * gaussSum χ' ψ₂ := by
    intro c
    split_ifs
    · simp
    · rw [gaussSum, mul_sum]
      exact sum_congr rfl fun b _ => by ring
  have hsum1 : ∑ c : ZMod p, (if c = 0 then 0 else ψ₁ c) = -1 := by
    have hc : ∀ c : ZMod p, (if c = 0 then 0 else ψ₁ c) = ψ₁ c - if c = 0 then 1 else 0 := by
      intro c; split_ifs with h <;> simp [h]
    rw [sum_congr rfl fun c _ => hc c, sum_sub_distrib, AddChar.sum_eq_zero_of_ne_one hψ₁,
      sum_ite_eq' univ (0 : ZMod p), if_pos (mem_univ _), zero_sub]
  calc gaussSum (changeLevel hdvd χ') ψ
      = ∑ x : ZMod p × ZMod k, changeLevel hdvd χ' (e.symm x) * ψ (e.symm x) := by
        rw [gaussSum]
        exact (Fintype.sum_equiv e.symm.toEquiv _ _ fun x => rfl).symm
    _ = ∑ c : ZMod p, ∑ b : ZMod k, (if c = 0 then 0 else χ' b) * (ψ₁ c * ψ₂ b) := by
        rw [Fintype.sum_prod_type]
        simp only [hχ, hsplit]
    _ = -gaussSum χ' ψ₂ := by
        simp only [hrow, ← sum_mul, hsum1, neg_one_mul]

/-- [proved-standard; formal-checked] **A character that sees every fibre has a Gauss sum that is not `0`:** if
`χ` mod `n` factors through no `n/p` with `p` prime and `p² ∣ n`, then `τ(χ, ψ) ≠ 0` for every primitive additive
character `ψ` of `ℤ/n`. -/
theorem gaussSum_ne_zero_of_fibres : ∀ (n : ℕ) [NeZero n] (χ : DirichletCharacter ℂ n),
    (∀ p, p.Prime → p ^ 2 ∣ n → ¬ χ.FactorsThrough (n / p)) →
    ∀ {ψ : AddChar (ZMod n) ℂ}, ψ.IsPrimitive → gaussSum χ ψ ≠ 0 := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro _ χ hχ ψ hψ
  by_cases hred : ∃ p, p.Prime ∧ p ∣ n ∧ ¬ p ^ 2 ∣ n ∧ χ.FactorsThrough (n / p)
  · obtain ⟨p, hp, ⟨k, rfl⟩, hpp, hf⟩ := hred
    have hk0 : k ≠ 0 := by rintro rfl; exact NeZero.ne (p * 0) (mul_zero p)
    have : NeZero k := ⟨hk0⟩
    have hpk : ¬ p ∣ k := fun h => hpp (by rw [pow_two]; exact mul_dvd_mul_left p h)
    have hcop : Nat.Coprime p k := (Nat.Prime.coprime_iff_not_dvd hp).2 hpk
    rw [Nat.mul_div_cancel_left k hp.pos] at hf
    obtain ⟨hdvd, χ', rfl⟩ := hf
    obtain ⟨ψ', hψ', heq⟩ := gaussSum_changeLevel_prime_mul hp hcop hdvd χ' hψ
    rw [heq, neg_ne_zero]
    have hlt : k < p * k := lt_mul_of_one_lt_left (Nat.pos_of_ne_zero hk0) hp.one_lt
    refine ih k hlt χ' (fun q hq hqk hfq => ?_) hψ'
    have hqk' : q ∣ k := (dvd_pow_self q two_ne_zero).trans hqk
    apply hχ q hq (hqk.trans (dvd_mul_left k p))
    obtain ⟨h1, χ'', rfl⟩ := hfq
    rw [← changeLevel_trans χ'' h1 hdvd]
    refine FactorsThrough.mono _ (changeLevel_factorsThrough χ'' (h1.trans hdvd)) ?_
      (Nat.div_dvd_of_dvd (hqk'.trans (dvd_mul_left k p)))
    rw [Nat.mul_div_assoc p hqk']
    exact dvd_mul_left _ _
  · push Not at hred
    apply gaussSum_ne_zero_of_isPrimitive _ hψ
    apply isPrimitive_of_not_factorsThrough
    intro p hp hpn hf
    by_cases hpp : p ^ 2 ∣ n
    · exact hχ p hp hpp hf
    · exact hred p hp hpn hpp hf

/-! ## 5. The neutral criterion -/

/-- [proved-standard; formal-checked] **The neutral criterion:** a scope `H ≤ (ℤ/n)ˣ` reads the primitive colour
`ζ_n` as `Tr_H(ζ_n) = 0` if and only if `n = p·m` with `p` prime, `p ∣ m`, and `H` holds the fibre
`ker((ℤ/n)ˣ → (ℤ/m)ˣ)`. -/
theorem scopeReading_eq_zero_iff {n : ℕ} [NeZero n] {ζ : ℂ} (hζ : IsPrimitiveRoot ζ n)
    (H : Subgroup (ZMod n)ˣ) [DecidablePred (· ∈ H)] :
    scopeReading H ζ = 0 ↔ ∃ p m : ℕ, ∃ hn : n = p * m, p.Prime ∧ p ∣ m ∧
      (ZMod.unitsMap (Dvd.intro_left p hn.symm)).ker ≤ H := by
  constructor
  · intro h0
    by_contra hne
    push Not at hne
    obtain ⟨χ, hχH, hχ⟩ := exists_char_ne_one_on_fibres H fun p hp hpp hg => by
      obtain ⟨hn, hpm⟩ := fibre_split hpp
      exact hne p (n / p) hn hp hpm (ker_le_of_fibreUnit_mem hp hpp _ H hg)
    exact gaussSum_ne_zero_of_fibres n χ hχ (AddChar.zmodChar_primitive_of_primitive_root n hζ)
      (charSum_eq_zero_of_neutral hζ H h0 χ hχH)
  · rintro ⟨p, m, hn, hp, hpm, hK⟩
    exact scopeReading_eq_zero_of_ker_le hp hn hpm hζ H hK

end Holonics.Mathematics.NeutralCriterion
