def responseNumerator (X : ℝ) : ℝ := horner numeratorCoefficients X

def responseDenominator (X : ℝ) : ℝ := horner denominatorCoefficients X

def selectedHighShape (X : ℝ) : ℝ := -responseNumerator X / responseDenominator X

def responseAmplitude (X : ℝ) : ℝ := 40 / 7 * X + 75

def responseCurvature (X : ℝ) : ℝ := -55 / 7 * X - 2325 / 26

theorem responseNumerator_positive {X : ℝ} (hX : 0 ≤ X) : 0 < responseNumerator X := by
  unfold responseNumerator
  simp only [numeratorCoefficients, horner]
  positivity

theorem responseDenominator_positive {X : ℝ} (hX : 0 ≤ X) : 0 < responseDenominator X := by
  unfold responseDenominator
  simp only [denominatorCoefficients, horner]
  positivity

theorem selectedHighShape_negative {X : ℝ} (hX : 0 ≤ X) : selectedHighShape X < 0 :=
  div_neg_of_neg_of_pos (neg_neg_of_pos (responseNumerator_positive hX))
    (responseDenominator_positive hX)

theorem selectedHighShape_repairs {X : ℝ} (hX : 0 ≤ X) :
    X * (responseNumerator X + responseDenominator X * selectedHighShape X) = 0 := by
  unfold selectedHighShape
  rw [mul_div_cancel₀ _ (responseDenominator_positive hX).ne']
  ring

theorem numerator_upper_denominator_lower :
    responseNumerator (1366 / 543) ≤ 27000000000 * responseDenominator (5625 / 2236) := by
  norm_num [responseNumerator, responseDenominator, numeratorCoefficients, denominatorCoefficients, horner]

theorem selectedHighShape_abs_bound {X : ℝ}
    (hlo : 5625 / 2236 ≤ X) (hhi : X ≤ 1366 / 543) : |selectedHighShape X| ≤ 27000000000 := by
  have hX : 0 ≤ X := by linarith
  have hn := horner_mono (cs := numeratorCoefficients) (by norm_num [numeratorCoefficients]) hX hhi
  have hd := horner_mono (cs := denominatorCoefficients) (by norm_num [denominatorCoefficients])
    (by norm_num : (0 : ℝ) ≤ 5625 / 2236) hlo
  rw [abs_of_neg (selectedHighShape_negative hX)]
  change -(-responseNumerator X / responseDenominator X) ≤ _
  rw [neg_div, neg_neg]
  apply (div_le_iff₀ (responseDenominator_positive hX)).mpr
  exact hn.trans (numerator_upper_denominator_lower.trans
    (mul_le_mul_of_nonneg_left hd (by norm_num)))

theorem responseCurvature_abs_bound {X : ℝ}
    (hlo : 5625 / 2236 ≤ X) (hhi : X ≤ 1366 / 543) : |responseCurvature X| ≤ 110 := by
  have hX : 0 ≤ X := by linarith
  have hn : responseCurvature X < 0 := by unfold responseCurvature; linarith
  rw [abs_of_neg hn]
  unfold responseCurvature
  linarith

theorem response_shape_admission {X mu : ℝ}
    (hlo : 5625 / 2236 ≤ X) (hhi : X ≤ 1366 / 543)
    (hmu : 0 ≤ mu) (hmuhi : mu ≤ 1 / 10000000) :
    4 / 5 < 1 + mu * responseAmplitude X -
      mu * (|responseCurvature X| / 8 + |selectedHighShape X| / 16384) := by
  have hX : 0 ≤ X := by linarith
  have hA : 0 ≤ responseAmplitude X := by unfold responseAmplitude; positivity
  have hB := responseCurvature_abs_bound hlo hhi
  have hE := selectedHighShape_abs_bound hlo hhi
  have hs : |responseCurvature X| / 8 + |selectedHighShape X| / 16384 ≤
      (110 : ℝ) / 8 + 27000000000 / 16384 := by linarith
  have hp := (mul_le_mul_of_nonneg_left hs hmu).trans
    (mul_le_mul_of_nonneg_right hmuhi (by norm_num : 0 ≤ (110 : ℝ) / 8 + 27000000000 / 16384))
  have hsmall : (1 / 10000000 : ℝ) * (110 / 8 + 27000000000 / 16384) < 1 / 5 := by norm_num
  nlinarith [mul_nonneg hmu hA]

theorem selected_axis_shape_positive {X a mu : ℝ}
    (hlo : 5625 / 2236 ≤ X) (hhi : X ≤ 1366 / 543) (ha : 0 < a)
    (hmu : 0 ≤ mu) (hmuhi : mu ≤ 1 / 10000000) (z : ℝ) :
    0 < shapeProfile (5 / 2) a (responseAmplitude X) (responseCurvature X) (selectedHighShape X) mu z :=
  shapeProfile_positive ha hmu (by have h := response_shape_admission hlo hhi hmu hmuhi; linarith)

theorem decaying_viscosity_admitted {mu0 delta t : ℝ}
    (hmu0 : 0 ≤ mu0) (hsmall : mu0 ≤ 1 / 10000000) (hdelta : 0 < delta) (ht : 0 ≤ t) :
    0 ≤ mu0 * Real.exp (-delta * t) ∧ mu0 * Real.exp (-delta * t) ≤ 1 / 10000000 := by
  have he : Real.exp (-delta * t) ≤ 1 := Real.exp_le_one_iff.mpr (by nlinarith)
  exact ⟨mul_nonneg hmu0 (Real.exp_pos _).le,
    (by have h := mul_le_mul_of_nonneg_left he hmu0; nlinarith)⟩

/-- Exact axis receiver of the unclosed quadratic-viscosity source of the affine-mu profile. -/
def quadraticAxisRemainder (X : ℝ) : ℝ :=
  595960 / 8281 * X ^ 3 + 43602575 / 30758 * X ^ 2 + 165625 / 26 * X

theorem quadraticAxisRemainder_positive {X : ℝ} (hX : 0 < X) :
    0 < quadraticAxisRemainder X := by
  unfold quadraticAxisRemainder
  positivity

theorem finite_viscosity_axis_remainder_nonzero {X mu : ℝ} (hX : 0 < X) (hmu : 0 < mu) :
    mu ^ 2 * quadraticAxisRemainder X ≠ 0 :=
  (mul_pos (sq_pos_of_pos hmu) (quadraticAxisRemainder_positive hX)).ne'

