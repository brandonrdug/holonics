theorem resonancePolynomial_continuous : Continuous resonancePolynomial := by
  unfold resonancePolynomial
  fun_prop

theorem resonancePolynomial_lower_negative : resonancePolynomial (5625 / 2236) < 0 := by
  norm_num [resonancePolynomial]

theorem resonancePolynomial_upper_positive : 0 < resonancePolynomial (1366 / 543) := by
  norm_num [resonancePolynomial]

theorem resonancePolynomial_has_positive_root :
    ∃ X : ℝ, 5625 / 2236 < X ∧ X < 1366 / 543 ∧ resonancePolynomial X = 0 := by
  have hbracket : (5625 / 2236 : ℝ) ≤ 1366 / 543 := by norm_num
  have hzero : (0 : ℝ) ∈ Icc (resonancePolynomial (5625 / 2236))
      (resonancePolynomial (1366 / 543)) :=
    ⟨le_of_lt resonancePolynomial_lower_negative, le_of_lt resonancePolynomial_upper_positive⟩
  obtain ⟨X, hX, hroot⟩ := intermediate_value_Icc hbracket
    resonancePolynomial_continuous.continuousOn hzero
  refine ⟨X, lt_of_le_of_ne hX.1 ?_, lt_of_le_of_ne hX.2 ?_, hroot⟩
  · intro heq
    have := resonancePolynomial_lower_negative
    rw [heq, hroot] at this
    exact lt_irrefl _ this
  · intro heq
    have := resonancePolynomial_upper_positive
    rw [← heq, hroot] at this
    exact lt_irrefl _ this

theorem resonancePolynomial_has_positive_amplitude :
    ∃ a : ℝ, 0 < a ∧ 5625 / 2236 < a ^ 2 ∧ a ^ 2 < 1366 / 543 ∧
      resonancePolynomial (a ^ 2) = 0 := by
  obtain ⟨X, hlo, hhi, hroot⟩ := resonancePolynomial_has_positive_root
  have hX : 0 < X := by linarith
  refine ⟨Real.sqrt X, Real.sqrt_pos.mpr hX, ?_⟩
  rw [Real.sq_sqrt (le_of_lt hX)]
  exact ⟨hlo, hhi, hroot⟩

#print axioms resonancePolynomial_lower_negative
#print axioms resonancePolynomial_upper_positive
#print axioms resonancePolynomial_has_positive_root
#print axioms resonancePolynomial_has_positive_amplitude

end Soma.Holonics.Millennium.NavierStokesResonanceAmplitude
