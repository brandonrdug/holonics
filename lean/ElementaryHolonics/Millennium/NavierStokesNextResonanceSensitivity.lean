def nextResonanceSlope (X : ℝ) : ℝ := positivePart X - negativeMagnitude X

def bracketLowerBound : ℝ := positivePart (5625 / 2236) - negativeMagnitude (1366 / 543)

theorem bracketLowerBound_positive : 0 < bracketLowerBound := by
  norm_num [bracketLowerBound, positivePart, negativeMagnitude]

theorem nextResonanceSlope_ge_bracketLowerBound {X : ℝ}
    (hlo : 5625 / 2236 ≤ X) (hhi : X ≤ 1366 / 543) :
    bracketLowerBound ≤ nextResonanceSlope X := by
  have hX : 0 ≤ X := by linarith
  have hp : positivePart (5625 / 2236) ≤ positivePart X := by
    unfold positivePart
    gcongr
  have hn : negativeMagnitude X ≤ negativeMagnitude (1366 / 543) := by
    unfold negativeMagnitude
    gcongr
  unfold bracketLowerBound nextResonanceSlope
  linarith

theorem nextResonanceSlope_positive_on_bracket {X : ℝ}
    (hlo : 5625 / 2236 ≤ X) (hhi : X ≤ 1366 / 543) :
    0 < nextResonanceSlope X :=
  bracketLowerBound_positive.trans_le (nextResonanceSlope_ge_bracketLowerBound hlo hhi)

theorem amplitude_root_has_positive_next_slope :
    ∃ X : ℝ, 5625 / 2236 < X ∧ X < 1366 / 543 ∧
      resonancePolynomial X = 0 ∧ 0 < nextResonanceSlope X := by
  obtain ⟨X, hlo, hhi, hroot⟩ := resonancePolynomial_has_positive_root
  exact ⟨X, hlo, hhi, hroot, nextResonanceSlope_positive_on_bracket hlo.le hhi.le⟩

/-- Once the remaining affine source value is returned, this coefficient has a unique repair.
The theorem does not manufacture or assume the value of that uncomputed fluid source. -/
theorem next_affine_row_has_unique_axial_coefficient {X : ℝ}
    (hlo : 5625 / 2236 ≤ X) (hhi : X ≤ 1366 / 543) (forcing : ℝ) :
    ∃! Y : ℝ, forcing + nextResonanceSlope X * Y = 0 := by
  have hR : nextResonanceSlope X ≠ 0 := (nextResonanceSlope_positive_on_bracket hlo hhi).ne'
  refine ⟨-forcing / nextResonanceSlope X, ?_, ?_⟩
  · field_simp
    ring
  · intro Y hY
    apply (eq_div_iff hR).mpr
    linarith

#print axioms bracketLowerBound_positive
#print axioms nextResonanceSlope_positive_on_bracket
#print axioms amplitude_root_has_positive_next_slope
#print axioms next_affine_row_has_unique_axial_coefficient

end Soma.Holonics.Millennium.NavierStokesNextResonanceSensitivity
