def horner : List ℝ → ℝ → ℝ
  | [], _ => 0
  | c :: cs, X => c + X * horner cs X

theorem horner_nonneg {cs : List ℝ} (hc : ∀ c ∈ cs, 0 ≤ c) {X : ℝ} (hX : 0 ≤ X) :
    0 ≤ horner cs X := by
  induction cs with
  | nil => simp [horner]
  | cons c cs ih =>
    exact add_nonneg (hc c (by simp)) (mul_nonneg hX (ih (fun c h ↦ hc c (by simp [h]))))

theorem horner_mono {cs : List ℝ} (hc : ∀ c ∈ cs, 0 ≤ c) {X Z : ℝ}
    (hX : 0 ≤ X) (hXZ : X ≤ Z) : horner cs X ≤ horner cs Z := by
  induction cs with
  | nil => simp [horner]
  | cons c cs ih =>
    have htail : ∀ c ∈ cs, 0 ≤ c := fun c h ↦ hc c (by simp [h])
    exact add_le_add le_rfl (mul_le_mul hXZ (ih htail)
      (horner_nonneg htail hX) (hX.trans hXZ))

theorem weighted_horner_le {B S X : ℝ} {cs ds : List ℝ}
    (h : List.Forall₂ (fun c d ↦ B * c ≤ S * d) cs ds) (hX : 0 ≤ X) :
    B * horner cs X ≤ S * horner ds X := by
  induction h with
  | nil => simp [horner]
  | @cons c d cs ds hcd hrest ih =>
    calc
      B * horner (c :: cs) X = B * c + X * (B * horner cs X) := by simp [horner]; ring
      _ ≤ S * d + X * (S * horner ds X) := add_le_add hcd (mul_le_mul_of_nonneg_left ih hX)
      _ = S * horner (d :: ds) X := by simp [horner]; ring

