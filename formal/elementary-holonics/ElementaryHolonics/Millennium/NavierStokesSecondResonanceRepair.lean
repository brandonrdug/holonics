def certificateScale : ℝ := 

def commonDenominator : ℝ := 

def numerator (X : ℝ) : ℝ :=
  horner lowCoefficients X - X ^ 7 * (horner coreCoefficients X + X ^ 10 * horner tailCoefficients X)

def forcing28 (X : ℝ) : ℝ := numerator X / commonDenominator

def selectedAxialCoefficient (X : ℝ) : ℝ := -forcing28 X / nextResonanceSlope X

theorem roundingDenominator_positive : 0 < roundingDenominator := by norm_num [roundingDenominator]
theorem certificateScale_positive : 0 < certificateScale := by norm_num [certificateScale]
theorem commonDenominator_positive : 0 < commonDenominator := by norm_num [commonDenominator]

theorem low_coefficient_bounds : List.Forall₂
    (fun c d ↦ roundingDenominator * c ≤ certificateScale * d) lowCoefficients roundedLow := by
  unfold lowCoefficients roundedLow
  refine List.Forall₂.cons ?_ (List.Forall₂.cons ?_ (List.Forall₂.cons ?_ (List.Forall₂.cons ?_ (List.Forall₂.cons ?_ (List.Forall₂.cons ?_ (List.Forall₂.cons ?_ (List.Forall₂.nil)))))))
  all_goals norm_num [roundingDenominator, certificateScale]

theorem core_coefficient_bounds : List.Forall₂
    (fun c d ↦ certificateScale * c ≤ roundingDenominator * d) roundedCore coreCoefficients := by
  unfold roundedCore coreCoefficients
  refine List.Forall₂.cons ?_ (List.Forall₂.cons ?_ (List.Forall₂.cons ?_ (List.Forall₂.cons ?_ (List.Forall₂.cons ?_ (List.Forall₂.cons ?_ (List.Forall₂.cons ?_ (List.Forall₂.cons ?_ (List.Forall₂.cons ?_ (List.Forall₂.cons ?_ (List.Forall₂.nil))))))))))
  all_goals norm_num [roundingDenominator, certificateScale]

theorem rounded_endpoint_gap :
    horner roundedLow (1366 / 543) < (5625 / 2236 : ℝ)^7 * horner roundedCore (5625 / 2236) := by
  norm_num [horner, roundedLow, roundedCore]

theorem numerator_negative_on_bracket {X : ℝ}
    (hlo : 5625 / 2236 ≤ X) (hhi : X ≤ 1366 / 543) : numerator X < 0 := by
  have hX : 0 ≤ X := by linarith
  have hl0 : (0 : ℝ) ≤ 5625 / 2236 := by norm_num
  have hc : 0 ≤ horner coreCoefficients X := horner_nonneg (by norm_num [coreCoefficients]) hX
  have ht : 0 ≤ horner tailCoefficients X := horner_nonneg (by norm_num [tailCoefficients]) hX
  have hu := weighted_horner_le low_coefficient_bounds hX
  have hu' := horner_mono (cs := roundedLow) (by norm_num [roundedLow]) hX hhi
  have hlow : roundingDenominator * horner lowCoefficients X ≤
      certificateScale * horner roundedLow (1366 / 543) :=
    hu.trans (mul_le_mul_of_nonneg_left hu' certificateScale_positive.le)
  have hd := weighted_horner_le core_coefficient_bounds hX
  have hd' := horner_mono (cs := roundedCore) (by norm_num [roundedCore]) hl0 hlo
  have hcore : certificateScale * horner roundedCore (5625 / 2236) ≤
      roundingDenominator * horner coreCoefficients X :=
    (mul_le_mul_of_nonneg_left hd' certificateScale_positive.le).trans hd
  have hp := pow_le_pow_left₀ hl0 hlo 7
  have hnegative : certificateScale * ((5625 / 2236 : ℝ)^7 * horner roundedCore (5625 / 2236)) ≤
      roundingDenominator * (X^7 * (horner coreCoefficients X + X^10 * horner tailCoefficients X)) := by
    calc
      _ = (5625 / 2236 : ℝ)^7 * (certificateScale * horner roundedCore (5625 / 2236)) := by ring
      _ ≤ (5625 / 2236 : ℝ)^7 * (roundingDenominator * horner coreCoefficients X) :=
        mul_le_mul_of_nonneg_left hcore (pow_nonneg hl0 7)
      _ ≤ X^7 * (roundingDenominator * horner coreCoefficients X) :=
        mul_le_mul_of_nonneg_right hp (mul_nonneg roundingDenominator_positive.le hc)
      _ = roundingDenominator * (X^7 * horner coreCoefficients X) := by ring
      _ ≤ _ := by
        exact mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_left
            (le_add_of_nonneg_right (mul_nonneg (pow_nonneg hX 10) ht))
            (pow_nonneg hX 7)) roundingDenominator_positive.le
  have hn : roundingDenominator * numerator X < 0 := by
    calc
      _ = roundingDenominator * horner lowCoefficients X -
        roundingDenominator * (X^7 * (horner coreCoefficients X + X^10 * horner tailCoefficients X)) := by
          unfold numerator
          ring
      _ ≤ certificateScale * horner roundedLow (1366 / 543) -
        certificateScale * ((5625 / 2236 : ℝ)^7 * horner roundedCore (5625 / 2236)) :=
          sub_le_sub hlow hnegative
      _ = certificateScale * (horner roundedLow (1366 / 543) -
        (5625 / 2236 : ℝ)^7 * horner roundedCore (5625 / 2236)) := by ring
      _ < 0 := mul_neg_of_pos_of_neg certificateScale_positive (sub_neg.mpr rounded_endpoint_gap)
  nlinarith [roundingDenominator_positive]

theorem forcing28_negative_on_bracket {X : ℝ}
    (hlo : 5625 / 2236 ≤ X) (hhi : X ≤ 1366 / 543) : forcing28 X < 0 :=
  div_neg_of_neg_of_pos (numerator_negative_on_bracket hlo hhi) commonDenominator_positive

theorem selectedAxialCoefficient_positive_on_bracket {X : ℝ}
    (hlo : 5625 / 2236 ≤ X) (hhi : X ≤ 1366 / 543) : 0 < selectedAxialCoefficient X :=
  div_pos (neg_pos.mpr (forcing28_negative_on_bracket hlo hhi))
    (nextResonanceSlope_positive_on_bracket hlo hhi)

theorem selectedAxialCoefficient_repairs {X : ℝ}
    (hlo : 5625 / 2236 ≤ X) (hhi : X ≤ 1366 / 543) :
    forcing28 X + nextResonanceSlope X * selectedAxialCoefficient X = 0 := by
  have hR := (nextResonanceSlope_positive_on_bracket hlo hhi).ne'
  unfold selectedAxialCoefficient
  rw [mul_div_cancel₀ _ hR]
  ring

theorem second_resonance_affine_repair :
    ∃ X Y : ℝ, 5625 / 2236 < X ∧ X < 1366 / 543 ∧ resonancePolynomial X = 0 ∧
      0 < Y ∧ forcing28 X + nextResonanceSlope X * Y = 0 := by
  obtain ⟨X, hlo, hhi, hroot⟩ := resonancePolynomial_has_positive_root
  exact ⟨X, selectedAxialCoefficient X, hlo, hhi, hroot,
    selectedAxialCoefficient_positive_on_bracket hlo.le hhi.le,
    selectedAxialCoefficient_repairs hlo.le hhi.le⟩

