import ElementaryHolonics.Foundation.Receiver

/-!
# Situated algorithms and exact execution paths

The extensional input/output relation is derived from a path.  It is not used
as the definition of process identity.
-/

namespace Soma.Holonics

universe u

/-- A finite, ordered path generated by a transition relation. -/
inductive Trace {S : Type u} (step : S → S → Prop) : S → S → Prop
  | refl (s : S) : Trace step s s
  | tail {a b c : S} : Trace step a b → step b c → Trace step a c

namespace Trace

theorem map {S : Type u} {T : Type*}
    {r : S → S → Prop} {q : T → T → Prop}
    (f : S → T)
    (map_step : ∀ {a b}, r a b → q (f a) (f b))
    {a b : S} :
    Trace r a b → Trace q (f a) (f b) := by
  intro h
  induction h with
  | refl =>
      exact Trace.refl _
  | tail h hab ih =>
      exact Trace.tail ih (map_step hab)

theorem trans {S : Type u} {r : S → S → Prop} {a b c : S}
    (hab : Trace r a b) (hbc : Trace r b c) :
    Trace r a c := by
  induction hbc with
  | refl =>
      exact hab
  | tail _ hstep ih =>
      exact Trace.tail ih hstep

end Trace

/--
An open parameterized transition system.  `Θ` selects the contemporary law;
initialization, transport, completion, and observation remain distinct.
-/
structure SituatedAlgorithm
    (Θ : Type*) (I : Type*) (S : Type*) (O : Type*) where
  init : Θ → I → S → Prop
  step : Θ → S → S → Prop
  done : Θ → S → Prop
  observe : Θ → S → O → Prop

namespace SituatedAlgorithm

/-- Extensional semantics derived from one admitted completed execution. -/
def Semantics {Θ I S O : Type*}
    (A : SituatedAlgorithm Θ I S O)
    (θ : Θ) (input : I) (output : O) : Prop :=
  ∃ s₀ sₙ,
    A.init θ input s₀ ∧
    Trace (A.step θ) s₀ sₙ ∧
    A.done θ sₙ ∧
    A.observe θ sₙ output

end SituatedAlgorithm

end Soma.Holonics
