// Exact graph of the stored dyadic normal operator. No target observation, fit or
// centre of a source family is selected here. The input axis rows are construction data.
extern "C" __global__ void section_normal_applied_relation(
    const int64_t *state,const int64_t *state_hi,uint32_t sources,uint32_t targets,uint32_t grain,
    int64_t *basis,int64_t *basis_hi,int64_t *workspace,
    uint32_t *slot,const uint32_t *census,const uint32_t *lineage,uint32_t lineage_count){
    if(blockIdx.x||threadIdx.x)return;
    if(upstream_refused(census,lineage,lineage_count,slot))return;
    if(!sources||!targets||grain<1||grain>120){atomicOr(slot,REFUSED_MALFORMED);return;}
    uint32_t f=2u*sources,w=f+2u*targets;
    for(size_t i=0;i<(size_t)2u*f*targets;++i)
        if(state[i]!=state_hi[i]){atomicOr(slot,REFUSED_MALFORMED);return;}
    for(size_t i=0;i<(size_t)w*w;++i)basis[i]=basis_hi[i]=0;
    const wide *M=(const wide *)state;wide *row=(wide *)workspace,S=(wide)1<<grain;
    for(uint32_t axis=0;axis<f;++axis){
        for(uint32_t j=0;j<w;++j)row[j]=0;
        row[axis]=S;
        for(uint32_t t=0;t<targets;++t){
            wide re=M[(size_t)t*f+2u*(axis/2u)],im=M[(size_t)t*f+2u*(axis/2u)+1u];
            row[f+2u*t]=(axis&1u)?sub_checked(0,im,slot):re;
            row[f+2u*t+1u]=(axis&1u)?re:im;
        }
        if(*slot)return;
        condition_stage_row(basis,basis_hi,w,row,slot);
        if(*slot)return;
    }
}

// A point observation consumes a unique producing pair, never a projected centre
// of a plural source. The forecast path does not require this point-only port.
extern "C" __global__ void section_normal_observation_rows(
    const int64_t *report,const int64_t *anchor,const int64_t *family,uint32_t source_width,uint32_t n,
    const int64_t *observed,const int64_t *observed_hi,uint32_t at,uint32_t den_at,uint32_t status_at,
    int64_t *out,int64_t *hi,uint32_t *slot,const uint32_t *census,const uint32_t *lineage,uint32_t lineage_count){
    if(blockIdx.x||threadIdx.x)return;
    if(upstream_refused(census,lineage,lineage_count,slot))return;
    uint32_t r=2u*n,a=4u*n;const wide *v=(const wide *)report,*ball=(const wide *)anchor;
    if(!n||v[0]!=0||v[2u+a]<=0){atomicOr(slot,REFUSED_MALFORMED);return;}
    bool affine_point=family[source_width+2u+2u*a+1u]==0;
    if(!affine_point){
        if(ball[a]!=0){atomicOr(slot,REFUSED_MALFORMED);return;}
        for(uint32_t i=0;i<a;++i)if(v[4u+3u*a+i]){atomicOr(slot,REFUSED_MALFORMED);return;}
    }
    wide den=fibre_current_denominator(observed,observed_hi,den_at,status_at,slot);
    if(*slot)return;
    for(uint32_t i=0;i<r;++i){
        if(observed[at+i]!=observed_hi[at+i]){atomicOr(slot,REFUSED_MALFORMED);return;}
        to_word(v[3u+a+i],slot);to_word(v[3u+a+r+i],slot);
    }
    to_word(v[2u+a],slot);to_word(den,slot);if(*slot)return;
    for(uint32_t row=0;row<2;++row){
        for(uint32_t i=0;i<r;++i)out[row*(r+1u)+i]=hi[row*(r+1u)+i]=(int64_t)v[3u+a+row*r+i];
        out[row*(r+1u)+r]=hi[row*(r+1u)+r]=(int64_t)v[2u+a];
    }
    for(uint32_t i=0;i<r;++i)out[2u*(r+1u)+i]=hi[2u*(r+1u)+i]=observed[at+i];
    out[3u*(r+1u)-1u]=hi[3u*(r+1u)-1u]=(int64_t)den;
}

// Boundary pair is known exactly, including nondyadic values. Its enclosing anchor
// remains available, but does not replace the original source by an entire ball.
extern "C" __global__ void section_normal_pair_family_seed(
    const int64_t *seed,const int64_t *seed_hi,uint32_t n,int64_t *out,int64_t *hi,int64_t *work,
    uint32_t *slot,const uint32_t *census,const uint32_t *lineage,uint32_t lineage_count){
    if(blockIdx.x||threadIdx.x)return;
    if(upstream_refused(census,lineage,lineage_count,slot))return;
    if(!n||n>(UINT32_MAX-7u)/8u){atomicOr(slot,REFUSED_MALFORMED);return;}
    uint32_t r=2u*n,a=4u*n,t=2u+2u*a,w=1u+t;
    for(uint32_t i=0;i<2u*(r+1u);++i)if(seed[i]!=seed_hi[i]){atomicOr(slot,REFUSED_MALFORMED);return;}
    wide pd=seed[r],cd=seed[2u*r+1u];
    if(pd<=0||cd<=0){atomicOr(slot,REFUSED_MALFORMED);return;}
    wide den=product_checked(pd,cd,slot),*row=(wide *)work;
    for(uint32_t i=0;i<t;++i)row[i]=0;row[0]=den;
    for(uint32_t i=0;i<r;++i){
        row[2u+i]=row[2u+a+i]=product_checked(seed[i],cd,slot);
        row[2u+r+i]=row[2u+a+r+i]=product_checked(seed[r+1u+i],pd,slot);
    }
    if(*slot)return;fibre_normalize(row,t,&den,slot);
    for(uint32_t i=0;i<t;++i)to_word(row[i],slot);to_word(den,slot);if(*slot)return;
    for(size_t i=0;i<(size_t)w+4u+(size_t)t*t;++i)out[i]=hi[i]=0;
    for(uint32_t i=0;i<t;++i)out[1u+i]=hi[1u+i]=(int64_t)row[i];
    out[w]=hi[w]=(int64_t)den;out[w+1u]=hi[w+1u]=0;out[w+2u]=hi[w+2u]=-1;
}
