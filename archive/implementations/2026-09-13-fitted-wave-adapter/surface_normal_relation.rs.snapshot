use super::*;
use crate::native_ecology::constitutive_fibre::normal_feature_state_words;
use crate::native_ecology::constitutive_fibre::{ResidentConstitutiveCurrent,ResidentNormalEnclosureView};
impl<'c> ResidentSurface<'c> {
    pub(crate) fn record_normal_observation_rows(&self,lane:&Lane<'_, 'c>,report:&ResidentSection<'c>,
        anchor:ResidentNormalEnclosureView<'_, 'c>,family:&ResidentSection<'c>,source_width:usize,roots:usize,observed:ResidentConstitutiveCurrent<'_, 'c>,out:&ResidentSection<'c>) -> Result<(),ResidentRefusal> {
        self.validate_constitutive_current_view(observed)?;
        let fail=||Self::operative_error();
        let r=roots.checked_mul(2).ok_or_else(fail)?;
        let a=r.checked_mul(2).ok_or_else(fail)?;
        let rw=a.checked_mul(4).and_then(|v|v.checked_add(4)).and_then(|v|v.checked_mul(2)).ok_or_else(fail)?;
        if roots==0 || roots>u32::MAX as usize/4 || observed.width!=r || anchor.width!=a ||
            !self.operative_shape(report,1,rw) || !self.operative_shape(out,3,r+1) ||
            (anchor.offset!=0 || !self.operative_shape(anchor.section,1,2*(a+1))) || !std::ptr::eq(anchor.section.surface,self) {return Err(fail());}
        let t=2+2*a;
        if !self.operative_shape(family,1,source_width+t+4+t*t) || source_width>u32::MAX as usize {return Err(fail());}
        let mut p=Params::new();p.ptr(report.lo.device_ptr()).ptr(anchor.section.lo.device_ptr()).ptr(family.lo.device_ptr()).u32(source_width as u32).u32(roots as u32)
            .ptr(observed.section.lo.device_ptr()).ptr(observed.section.hi.device_ptr()).u32(observed.offset as u32)
            .u32(observed.denominator.map_or(u32::MAX,|v|v as u32)).u32(observed.disposition.map_or(u32::MAX,|v|v as u32))
            .ptr(out.lo.device_ptr()).ptr(out.hi.device_ptr()).ptr(lane.slot).ptr(lane.census).ptr(lane.lineage).u32(lane.lineage_count);
        self.record_blocks(lane,"section_normal_observation_rows",1,self.declaration.warp_size.max(1),0,&mut p,"normal-observation-rows")
    }
    pub(crate) fn record_normal_pair_family_seed(&self,lane:&Lane<'_, 'c>,seed:&ResidentSection<'c>,roots:usize,
        out:&ResidentSection<'c>,work:&ResidentSection<'c>) -> Result<(),ResidentRefusal> {
        let fail=||Self::operative_error();
        let t=roots.checked_mul(8).and_then(|v|v.checked_add(2)).ok_or_else(fail)?;
        if roots==0||t>u32::MAX as usize-5||!self.operative_shape(seed,2,2*roots+1)||
            !self.operative_shape(out,1,t+5+t*t)||!self.operative_shape(work,1,2*t){return Err(fail());}
        let mut p=Params::new();p.ptr(seed.lo.device_ptr()).ptr(seed.hi.device_ptr()).u32(roots as u32)
            .ptr(out.lo.device_ptr()).ptr(out.hi.device_ptr()).ptr(work.lo.device_ptr())
            .ptr(lane.slot).ptr(lane.census).ptr(lane.lineage).u32(lane.lineage_count);
        self.record_blocks(lane,"section_normal_pair_family_seed",1,self.declaration.warp_size.max(1),0,&mut p,"normal-pair-family-seed")
    }
    pub(crate) fn record_normal_applied_relation(&self,lane:&Lane<'_, 'c>,state:&ResidentSection<'c>,
        sources:usize,targets:usize,grain:u32,basis:&ResidentSection<'c>,work:&ResidentSection<'c>) -> Result<(),ResidentRefusal> {
        let fail=||Self::operative_error();
        let w=sources.checked_add(targets).and_then(|v|v.checked_mul(2)).ok_or_else(fail)?;
        let sw=normal_feature_state_words(sources,targets).ok_or_else(fail)?;
        if w>u32::MAX as usize || !(1..=120).contains(&grain) ||
            !self.operative_shape(state,1,sw) || !self.operative_shape(basis,w,w) ||
            !self.operative_shape(work,1,2*w) {return Err(fail());}
        let mut p=Params::new();
        p.ptr(state.lo.device_ptr()).ptr(state.hi.device_ptr()).u32(sources as u32).u32(targets as u32).u32(grain)
            .ptr(basis.lo.device_ptr()).ptr(basis.hi.device_ptr()).ptr(work.lo.device_ptr())
            .ptr(lane.slot).ptr(lane.census).ptr(lane.lineage).u32(lane.lineage_count);
        self.record_blocks(lane,"section_normal_applied_relation",1,self.declaration.warp_size.max(1),0,&mut p,"normal-applied-relation")
    }
}
