 use super::super::super::comparison_tests::{current, point};
 use super::super::tests::{body, law};
 use super::*;
+
+#[test]
+#[ignore = "requires CUDA; exact nondyadic boundary pairs retain their source through native family transport and v2 rest"]
+fn boundary_pair_rests_without_a_bank_and_keeps_exact_source() {
+    let readout=ResidentReadout::new().unwrap();let s=ResidentSurface::on(&readout).unwrap();
+    let p=point(&s,&[1,0,3]);let c=point(&s,&[2,0,5]);
+    let start=NormalWaveFamily::from_point_pair(&s,ResidentConstitutiveCurrent::rational(&p).unwrap(),
+        ResidentConstitutiveCurrent::rational(&c).unwrap(),ResidentGrain(8),7).unwrap();
+    assert!(start.origin().fibre().inspect_material().is_err());
+    let value=start.read_receiver().unwrap().inspect().unwrap();
+    assert_eq!(value.projected_state(0).unwrap(),&[Rat::new(1.into(),3.into()),Rat::from_integer(0.into()),Rat::new(2.into(),5.into()),Rat::from_integer(0.into())]);
+    assert!(start.anchor().inspect().unwrap().radius>Rat::from_integer(0.into()));
+    let observed=point(&s,&[3,0,7]);
+    let rows=start.observation_rows(ResidentConstitutiveCurrent::rational(&observed).unwrap()).unwrap();
+    let values=s.detach_section(&rows,64).unwrap();
+    let decoded:Vec<_>=values.intervals.chunks_exact(3).flat_map(|v| [Rat::new(v[0].0.into(),v[2].0.into()),Rat::new(v[1].0.into(),v[2].0.into())]).collect();
+    assert_eq!(decoded,vec![Rat::new(1.into(),3.into()),Rat::from_integer(0.into()),Rat::new(2.into(),5.into()),Rat::from_integer(0.into()),Rat::new(3.into(),7.into()),Rat::from_integer(0.into())]);
+    let learned=law(&s,false);let h=point(&s,&[0,1]);
+    let transported=start.read_through(Rc::new(learned.read_wave_relation(current(&h),1).unwrap())).unwrap();
+    let wire=bytes(&transported);
+    assert_eq!(wire[b"HOLONIC-ANCHORED-WAVE-FAMILY".len()],2);
+    let saved=NormalWaveFamilyRest::read(&mut wire.as_slice(),wire.len() as u64).unwrap();
+    let restored=saved.remount(&s).unwrap();
+    assert_eq!(bytes(&restored),wire);
+    assert_eq!(serde_json::to_value(restored.read_receiver().unwrap().inspect().unwrap()).unwrap(),
+        serde_json::to_value(transported.read_receiver().unwrap().inspect().unwrap()).unwrap());
+    let mut malformed=start.rest().unwrap();
+    if let OriginRest::Pair {seed,..}=&mut malformed.origin {seed.intervals[2]=(0,0);}
+    assert!(malformed.validate().is_err());
+}
