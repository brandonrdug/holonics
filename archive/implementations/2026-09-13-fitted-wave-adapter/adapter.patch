+        assert_eq!(q["value"]["prediction"],id);
+        let returned=send(&mut session,&mut stream,MathematicalRequest::ObserveSection {predictor:0,prediction:id as u64,observed:row(&[h*(c-p),0])});
+        assert_eq!(returned["value"]["observations"],id+1,"{returned}");
+    }
+    let original=session.predictors[&0].material.inspect().unwrap();
+    let coefficients:Vec<_>=original.material.coefficients[0].iter().map(|v|{assert!(v.imaginary.is_zero());v.real.clone()}).collect();
+    let step=|p:&BigRational,c:&BigRational,h:i64| {
+        let h=BigRational::from_integer(h.into());let a=[c-p,c.clone(),p.clone()];
+        let u=vec![a[0].clone(),a[1].clone(),a[2].clone(),h.clone(),&h*&a[0],&h*&a[1],&h*&a[2]];
+        c+coefficients.iter().zip(u).map(|(m,u)|m*u).sum::<BigRational>()
+    };
+    let bound=send(&mut session,&mut stream,MathematicalRequest::BindPredictorWave {predictor:0,previous:row(&[0,0]),current:row(&[1,0]),condition:row(&[1,0]),alphabet:None});
+    assert_eq!(bound["value"]["status"],"predictor-wave-bound","{bound}");
+    let forecast=send(&mut session,&mut stream,MathematicalRequest::PredictWave {predictor:0,steps:2,commit:false,retain_prediction:false,condition:None});
+    let released=send(&mut session,&mut stream,MathematicalRequest::PredictWave {predictor:0,steps:2,commit:true,retain_prediction:true,condition:None});
+    assert_eq!(released["value"]["status"],"wave-released","{released}");
+    assert_eq!(forecast["value"]["joint"],released["value"]["joint"]);
+    assert_eq!(released["value"]["successor_epoch"],1);
+    let p=BigRational::zero();let c=BigRational::one();let first=step(&p,&c,1);let second=step(&c,&first,1);
+    let endpoint:Vec<BigRational>=serde_json::from_value(released["value"]["endpoint"]["projected_joint"].clone()).unwrap();
+    assert_eq!(endpoint,vec![first.clone(),BigRational::zero(),second.clone(),BigRational::zero()]);
+    // A later forecast changes no retained producing cut. The observed value is a
+    // target for the final step's original pair, not the contemporary endpoint.
+    let later=send(&mut session,&mut stream,MathematicalRequest::PredictWave {predictor:0,steps:1,commit:false,retain_prediction:false,condition:Some(row(&[-1,0]))});
+    assert_eq!(later["value"]["predecessor_epoch"],1);
+    let id=released["value"]["prediction"].as_u64().unwrap();
+    let result=send(&mut session,&mut stream,MathematicalRequest::ObserveWave {predictor:0,prediction:id,observed:row(&[0,0])});
+    assert_eq!(result["value"]["observations"],5,"{result}");
+    assert!(session.request(&MathematicalRequest::ObserveWave {predictor:0,prediction:id,observed:row(&[0,0])}).is_err());
+    let next=send(&mut session,&mut stream,MathematicalRequest::PredictWave {predictor:0,steps:1,commit:true,retain_prediction:false,condition:Some(row(&[-1,0]))});
+    assert_eq!(next["value"]["successor_epoch"],2,"{next}");
+    assert_ne!(later["value"]["endpoint"],next["value"]["endpoint"]);
+}
