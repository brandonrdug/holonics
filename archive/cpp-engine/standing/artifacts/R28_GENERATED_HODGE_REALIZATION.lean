def translationStatement : Prop :=
  (∀ x z : ℤ, z^2*x*(x-1)*(x-z) = x*z*(z-x)*(z-z*x)) ∧
  (∀ x z : ℤ, (1-z)^2*x*(x-1)*(x-z) = (x-1)*(x-z)*(1-z)*(x*(1-z))) ∧
  (∀ x z : ℤ, (z*(z-1))^2*x*(x-1)*(x-z) = (x-z)*(z*(x-1))*(x*(z-1))*(z*(z-1))) ∧
  (∀ x z : ℤ, 0*x-z*1 = -z) ∧
  (∀ x z : ℤ, 1*(x-1)-(x-z)*1 = -(1-z)) ∧
  (∀ x z : ℤ, z*(x-z)-z*(x-1) = -(z*(z-1)))
theorem generated_translations : translationStatement := by
  unfold translationStatement
  constructor
  · intro x z; ring
  constructor
  · intro x z; ring
  constructor
  · intro x z; ring
  constructor
  · intro x z; ring
  constructor <;> intro x z <;> ring

